%% Product Governance Loop: read top to bottom from the installable product into the operator shell, then follow the governed truth loop.
flowchart TB
    odylith["Odylith product<br/>installable CLI + runtime"]
    dashboard["Dashboard<br/>operator shell + surface navigation"]

    subgraph truth["Governed product truth"]
        direction TB
        registry["Registry<br/>component ownership + specs"]
        atlas["Atlas<br/>architecture diagrams + freshness"]
        radar["Radar<br/>ranked workstreams + queues"]
        plans["Technical Plans<br/>implementation intent + gates"]
        compass["Compass<br/>execution timeline + proof"]
        casebook["Casebook<br/>bugs, failed mechanisms,<br/>prior fix attempts"]
    end

    odylith --> dashboard
    dashboard --> radar
    dashboard --> registry
    dashboard --> atlas

    registry -- "component scope" --> radar
    radar -- "selected slice" --> plans
    plans -- "planned change + proof obligations" --> compass
    compass -- "evidence, blockers, regressions" --> casebook
    casebook -- "do not repeat failed mechanisms" --> radar
    atlas -- "topology truth" --> registry
    registry -- "component dossiers explain diagrams" --> atlas

    classDef product fill:#ECFDFB,stroke:#A7E9E3,color:#132033,stroke-width:1px;
    classDef shell fill:#EFF6FF,stroke:#BFD7FE,color:#132033,stroke-width:1px;
    classDef truth fill:#F5F3FF,stroke:#DDD6FE,color:#132033,stroke-width:1px;
    classDef proof fill:#F5F3FF,stroke:#DDD6FE,color:#132033,stroke-width:1px;
    class odylith product;
    class dashboard shell;
    class registry,atlas,radar,plans truth;
    class compass,casebook proof;
    style truth fill:#FBFDFF,stroke:#DDD6FE,stroke-width:1px,color:#293D52
    linkStyle default stroke:#B9C7D8,stroke-width:1.25px
