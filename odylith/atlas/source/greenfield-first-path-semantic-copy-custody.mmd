flowchart LR
    subgraph assignment["Runner-owned assignment"]
      direction TB
      evidence["Prompt or sealed EDIT evidence<br/>exact bytes and hashes"]
      contract["Materiality, graph, and timing contracts<br/>60 / 90 / explicit 120<br/>zero retries and automatic deep"]
      identities["Independent run identities<br/>critic, full-source author,<br/>source-only author, selector"]
    end

    subgraph standard["Independent standard evidence"]
      direction TB
      critic["Prompt-only materiality critic<br/>nine canonical fields<br/>no candidates or validator feedback"]
      full["Full-source graph author<br/>typed facts, relations, citations,<br/>mandatory self-challenge"]
      source_only["Source-only graph author<br/>independent evidence view<br/>typed facts, relations, citations"]
    end

    subgraph admission["Deterministic candidate admission"]
      direction TB
      full_check["Admit full-source candidate<br/>citation, endpoint, ownership,<br/>polarity, completeness, package laws"]
      source_check["Admit source-only candidate<br/>same exact laws<br/>no candidate-specific fallback"]
      compare["Typed source comparison<br/>supported facts, omissions,<br/>material disagreements, utility"]
      standard_choice{"Standard convergence?"}
    end

    subgraph rescue["Selection-only bounded rescue"]
      direction TB
      handoff["Reusable typed handoff<br/>only already-admitted candidates<br/>and exact disagreement evidence"]
      selector["One final host decision<br/>select full, select source-only,<br/>or ask one material question"]
      no_authorship["No graph authorship<br/>no merge, repair, regex,<br/>token, fuzzy, or prose parser"]
    end

    clarification["One focused material question<br/>no authority or governed writes"]
    selected["One admitted candidate<br/>unchanged graph bytes"]
    transaction["Verified ProductCreateTransaction<br/>complete governed package<br/>sealed before confirmation"]
    authority["CONFIRM publishes exact sealed bytes<br/>no post-confirm model or repair"]

    evidence --> critic
    evidence --> full
    evidence --> source_only
    contract --> critic
    contract --> full
    contract --> source_only
    identities --> critic
    identities --> full
    identities --> source_only
    full --> full_check
    source_only --> source_check
    critic --> compare
    full_check --> compare
    source_check --> compare
    compare --> standard_choice
    standard_choice -- "one safe candidate" --> selected
    standard_choice -- "materially unresolved" --> clarification
    standard_choice -- "reusable typed disagreement" --> handoff
    handoff --> selector --> no_authorship
    selector -- "clarify" --> clarification
    selector -- "select existing graph" --> selected
    selected --> transaction --> authority
    clarification -- "new EDIT evidence" --> evidence

    classDef assignment fill:#EFF6FF,stroke:#60A5FA,color:#132033,stroke-width:1.2px;
    classDef standard fill:#F0FDF4,stroke:#4ADE80,color:#132033,stroke-width:1.2px;
    classDef verify fill:#F8FAFC,stroke:#94A3B8,color:#132033,stroke-width:1.2px;
    classDef rescue fill:#FFF7ED,stroke:#FB923C,color:#132033,stroke-width:1.2px;
    classDef terminal fill:#F5F3FF,stroke:#8B5CF6,color:#132033,stroke-width:1.2px;
    class evidence,contract,identities assignment;
    class critic,full,source_only standard;
    class full_check,source_check,compare,standard_choice verify;
    class handoff,selector,no_authorship rescue;
    class clarification,selected,transaction,authority terminal;

    style assignment fill:#FBFDFF,stroke:#60A5FA,stroke-width:1px,color:#293D52
    style standard fill:#F8FFF9,stroke:#4ADE80,stroke-width:1px,color:#293D52
    style admission fill:#FBFDFF,stroke:#94A3B8,stroke-width:1px,color:#293D52
    style rescue fill:#FFFBF5,stroke:#FB923C,stroke-width:1px,color:#293D52
    linkStyle default stroke:#9FB2C8,stroke-width:1.25px
