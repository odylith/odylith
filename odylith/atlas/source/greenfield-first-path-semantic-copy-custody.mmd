flowchart LR
    subgraph source_lane["Source evidence"]
      direction TB
      request["Original request and EDIT evidence<br/>Exact text retained as untrusted input"]
      source_units["Source units and occurrence ids<br/>Stable citation targets"]
      model_author["One host-model author<br/>Interprets the whole request once"]
    end

    subgraph graph_lane["Canonical typed meaning"]
      direction TB
      facts["Source-cited facts<br/>Story, state, actors, systems,<br/>responsibilities, risks, and proof"]
      events["Ordered event bindings<br/>Selected actor fact, source-bound target,<br/>and recovery meaning"]
      terminal["Terminal result binding<br/>Exact selected output citation"]
      custody["Deterministic custody compiler<br/>Byte spans, actor kind, action fact,<br/>target binding, event order, and final result"]
      completeness{"Material facts and<br/>relations complete?"}
      clarify["Clarification required<br/>Missing or conflicting material meaning<br/>stops before persistence"]
      canonical["Canonical direct-evidence graph<br/>Single semantic owner"]
    end

    subgraph consumer_lane["Deterministic consumers"]
      direction TB
      project["Project story and first path"]
      radar["Radar outcomes and work"]
      registry["Registry ownership contracts"]
      atlas["Atlas event and boundary topology"]
      compass["Compass decisions and proof"]
      evaluator["Release evaluator<br/>Reads the same typed relations<br/>and product-owned Mermaid parser"]
    end

    subgraph transaction_lane["Persistence law"]
      direction TB
      seal["Sealed transaction<br/>Exact projections and source custody"]
      confirm["CONFIRM is commit-only<br/>No semantic reinterpretation"]
      readback["Readback must equal<br/>the reviewed transaction"]
    end

    request --> source_units --> model_author
    model_author --> facts
    model_author --> events
    model_author --> terminal
    facts --> custody
    events --> custody
    terminal --> custody --> completeness
    completeness -- "no" --> clarify
    completeness -- "yes" --> canonical
    canonical --> project
    canonical --> radar
    canonical --> registry
    canonical --> atlas
    canonical --> compass
    canonical --> evaluator
    project --> seal
    radar --> seal
    registry --> seal
    atlas --> seal
    compass --> seal
    seal --> confirm --> readback
    readback -. "semantic parity" .-> evaluator

    classDef primary fill:#EFF6FF,stroke:#BFD7FE,color:#132033,stroke-width:1px;
    classDef semantic fill:#ECFDFB,stroke:#A7E9E3,color:#132033,stroke-width:1px;
    classDef governance fill:#F5F3FF,stroke:#DDD6FE,color:#132033,stroke-width:1px;
    classDef constraint fill:#FFF8E6,stroke:#F6D98B,color:#132033,stroke-width:1px;
    class request,source_units,model_author primary;
    class facts,events,terminal,custody,canonical,project,radar,registry,atlas,compass,evaluator semantic;
    class seal,confirm,readback governance;
    class completeness,clarify constraint;

    style source_lane fill:#FBFDFF,stroke:#BFD7FE,stroke-width:1px,color:#293D52
    style graph_lane fill:#F8FFFE,stroke:#A7E9E3,stroke-width:1px,color:#293D52
    style consumer_lane fill:#F8FFFE,stroke:#A7E9E3,stroke-width:1px,color:#293D52
    style transaction_lane fill:#FCFBFF,stroke:#DDD6FE,stroke-width:1px,color:#293D52
    linkStyle default stroke:#9FB2C8,stroke-width:1.25px
