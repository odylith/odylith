flowchart TB
    subgraph evidence_lane["Operator evidence"]
      direction TB
      request["Original request<br/>Retained as untrusted evidence"]
      edit["EDIT correction<br/>Bound to the retained sealed source"]
      prepare["Product-owned prepare route<br/>One supervised parent before contract acquisition;<br/>manual commands retain local source custody only"]
      contract["Candidate contract<br/>Public schemas and exact operator source"]
    end

    subgraph host_lane["Host-native first-path decision and authoring"]
      direction TB
      gate["Independent authority gate<br/>Does the requested product name an owner,<br/>usable task and observable result?"]
      gate_check{"Source-bound witness<br/>or material gap?"}
      host["Source-duty inventory<br/>Records product identity, performers, actions and targets;<br/>marks declared workflow membership and recurring safeguards"]
      candidate["Closed source result<br/>Typed inventory or one material question;<br/>inventory keeps every duty and exact source reference"]
      identity_check["Source identity and performer custody preflight<br/>Resolve the product identity separately from actors;<br/>retain exact performer quotes in normalized statements"]
      prior_contract["Accepted EDIT baseline<br/>Exact source addresses, action allocation edges and verification flags;<br/>typed system roster retained under a bounded context"]
      source_control["Source-only verifier<br/>Affirms identity, complete duties, workflow roles and recurrence;<br/>every surviving EDIT action keeps its exact allocation edges"]
      catalog["One complete source-event graph<br/>Fixed performers and event IDs come from verified actions;<br/>a whole-product performer does not create another subsystem"]
      candidate_author["One candidate authoring pass<br/>Authors design using fixed events and accepted EDIT custody;<br/>cannot erase accepted systems or reassign surviving prior actions"]
    end

    subgraph admission_lane["Deterministic admission"]
      direction TB
      validator["Deterministic validator and custody compiler<br/>Rebuilds source product identity and the fixed actor/event catalog;<br/>checks exact source spans, lifecycle, relations and hashes"]
      complete{"Complete and<br/>source-grounded?"}
      clarify["One focused clarification<br/>No package, transaction or governed write"]
      invalid_candidate["Invalid or tampered candidate<br/>Fail closed with no second model,<br/>repair, retry, fallback or governed write"]
      canonical["Canonical Product Intent envelope<br/>Candidate, source, product-fact and relation hashes bound"]
    end

    subgraph projection_lane["Deterministic governance projections"]
      direction TB
      source_views["Derived workflow and proposed first run<br/>Workflow membership comes from verified source roles;<br/>first run may add cited discrete prerequisites"]
      safeguards["Recurring safeguards<br/>Keep conditional guards, lifecycle custody and proof;<br/>remain outside the one-time run"]
      project["Project summary and declared first path<br/>Proposed implementation walkthrough stays separate;<br/>evidence and record metadata remain in supporting details"]
      radar["Proportional grounded Radar workstreams"]
      registry["Genuinely owned Registry components"]
      atlas["Distinct detailed Atlas diagrams<br/>Typed performer-to-event relations preserved"]
      compass["Compass decisions and proof"]
    end

    subgraph transaction_lane["Sealed transaction"]
      direction TB
      seal["Sealed transaction<br/>Exact projections, canonical host receipt<br/>and zero post-receipt semantic calls"]
      quarantine["New pending seal quarantined before visibility<br/>Completion digest alone cannot permit confirmation"]
      finalize["Retain, clean, finish observer and completion-record I/O<br/>Certify only within both final deadlines;<br/>preserve the original EDIT seal and receipt"]
      receipt["Completion receipt delivery<br/>Private nonce issued after certification;<br/>delivery follows measured preparation"]
      cancelled["Expired journey<br/>No confirmable new seal or successful preview"]
      decision{"Operator decision"}
      confirm["CONFIRM with delivered receipt<br/>Commit-only publication"]
      revise["EDIT<br/>Reverify current source with the accepted baseline;<br/>unsupported system roster changes refuse before candidate generation"]
      reject["REJECT<br/>No governed writes"]
      readback["Readback equals sealed bytes"]
    end

    subgraph release_lane["Detached release qualification"]
      direction TB
      frozen["Frozen campaign evidence<br/>Immutable retained outputs and browser states"]
      timing["Shared runtime supervision<br/>300-second gate and candidate window plus 15-second reserve;<br/>independent guardian cancels blocked work and child groups;<br/>660-second whole cap remains diagnostic and unqualified"]
      source_predicates["Frozen public source predicates<br/>Exact forward coverage and reverse invention audit;<br/>independent review binds retained evidence"]
      evaluator["Independent semantic and UX evaluator<br/>Reads evidence only; never changes<br/>consumer candidate or transaction"]
      qualified["Pinned profile qualified or blocked<br/>Transaction authority remains unchanged"]
    end

    request --> prepare --> contract
    edit --> prepare
    revise -. "authenticated prior package" .-> prior_contract
    prior_contract --> source_control
    prior_contract --> candidate_author
    contract --> gate --> gate_check
    gate_check -- "first path missing" --> clarify
      gate_check -- "operator-owned witnesses" --> host --> candidate --> identity_check
    identity_check -- "valid inventory" --> source_control --> catalog --> candidate_author --> validator --> complete
    identity_check -- "valid question" --> clarify
    validator -- "invalid or tampered" --> invalid_candidate
    complete -- "no" --> clarify
    complete -- "yes" --> canonical
    canonical --> source_views --> project
    canonical --> safeguards
    safeguards --> registry
    safeguards --> atlas
    canonical --> radar
    canonical --> registry
    canonical --> atlas
    canonical --> compass
    project --> seal
    radar --> seal
    registry --> seal
    atlas --> seal
    compass --> seal
    seal --> quarantine --> finalize --> receipt --> decision
    prepare -. "nonreplenishing deadline" .-> timing
    timing -- "expiry" --> cancelled
    decision -- "CONFIRM" --> confirm --> readback
    decision -- "EDIT" --> revise --> prepare
    decision -- "REJECT" --> reject
    canonical -. "immutable campaign input" .-> frozen --> source_predicates --> evaluator --> qualified

    classDef evidence fill:#EFF6FF,stroke:#BFD7FE,color:#132033,stroke-width:1px;
    classDef semantic fill:#ECFDFB,stroke:#A7E9E3,color:#132033,stroke-width:1px;
    classDef governance fill:#F5F3FF,stroke:#DDD6FE,color:#132033,stroke-width:1px;
    classDef constraint fill:#FFF8E6,stroke:#F6D98B,color:#132033,stroke-width:1px;
    class request,edit,prepare,contract,prior_contract,gate,host,candidate,identity_check,candidate_author evidence;
    class source_control,catalog semantic;
    class validator,canonical,source_views,safeguards,project,radar,registry,atlas,compass semantic;
    class seal,quarantine,finalize,receipt,decision,confirm,revise,reject,readback governance;
    class frozen,source_predicates,evaluator,qualified governance;
    class gate_check,complete,clarify,invalid_candidate,cancelled,timing constraint;

    style evidence_lane fill:#FBFDFF,stroke:#BFD7FE,stroke-width:1px,color:#293D52
    style host_lane fill:#FBFDFF,stroke:#BFD7FE,stroke-width:1px,color:#293D52
    style admission_lane fill:#F8FFFE,stroke:#A7E9E3,stroke-width:1px,color:#293D52
    style projection_lane fill:#F8FFFE,stroke:#A7E9E3,stroke-width:1px,color:#293D52
    style transaction_lane fill:#FCFBFF,stroke:#DDD6FE,stroke-width:1px,color:#293D52
    style release_lane fill:#FFFCF3,stroke:#F6D98B,stroke-width:1px,color:#293D52
    linkStyle default stroke:#9FB2C8,stroke-width:1.25px
