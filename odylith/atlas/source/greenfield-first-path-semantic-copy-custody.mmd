flowchart LR
    subgraph evidence_lane["Operator evidence"]
      direction TB
      request["Original request<br/>Retained as untrusted evidence"]
      edit["EDIT correction<br/>Bound to the retained sealed source"]
      contract["Candidate contract<br/>Public schemas and exact operator source"]
    end

    subgraph host_lane["Host-native first-path decision and authoring"]
      direction TB
      gate["Independent authority gate<br/>Does the requested product name an owner,<br/>usable task and observable result?"]
      gate_check{"Source-bound witness<br/>or material gap?"}
      host["Normalized source-duty ledger v5<br/>One source owner for role, action, target and lifecycle duties"]
      candidate["Compact source bank v3 evidence<br/>Host resolves every ID; compiler verifies each exact<br/>quote and context against the full source"]
      identity_check["Source field and performer custody preflight<br/>Resolve declared object and field identities;<br/>retain exact performer quotes in normalized statements"]
      source_control["Compact source-only verifier and canonical ledger<br/>Judge one performer and complete source duties;<br/>closed decisions bind the stronger task hash"]
      candidate_author["One candidate authoring pass<br/>Lossless compact accepted inventory and custody hashes;<br/>full accepted receipt remains compiler-owned"]
    end

    subgraph admission_lane["Deterministic admission"]
      direction TB
      validator["Deterministic validator and custody compiler<br/>Reuses verified performer and state identities; restores<br/>action and target; checks bindings, relations and hashes"]
      complete{"Complete and<br/>source-grounded?"}
      clarify["One focused clarification<br/>No package, transaction or governed write"]
      invalid_candidate["Invalid or tampered candidate<br/>Fail closed with no second model,<br/>repair, retry, fallback or governed write"]
      canonical["Canonical Product Intent envelope<br/>Candidate, source, product-fact and relation hashes bound"]
    end

    subgraph projection_lane["Deterministic governance projections"]
      direction TB
      project["Project story and one coherent first run<br/>Alternate events remain retained"]
      radar["4–5 grounded Radar workstreams"]
      registry["4–5 Registry components"]
      atlas["5+ detailed Atlas diagrams<br/>Typed performer-to-event relations preserved"]
      compass["Compass decisions and proof"]
    end

    subgraph transaction_lane["Sealed transaction"]
      direction TB
      seal["Sealed transaction<br/>Exact projections, canonical host receipt<br/>and zero post-receipt semantic calls"]
      decision{"Operator decision"}
      confirm["CONFIRM<br/>Commit-only publication"]
      revise["EDIT<br/>New candidate contract from old seal + correction"]
      reject["REJECT<br/>No governed writes"]
      readback["Readback equals sealed bytes"]
    end

    subgraph release_lane["Detached release qualification"]
      direction TB
      frozen["Frozen campaign evidence<br/>Immutable retained outputs and browser states"]
      timing["Budget contract<br/>300-second shared gate and candidate model window;<br/>315-second proposal cap includes 15-second completion reserve;<br/>fixed 660-second whole deadline is non-additive and unqualified"]
      evaluator["Independent semantic and UX evaluator<br/>Reads evidence only; never changes<br/>consumer candidate or transaction"]
      qualified["Pinned profile qualified or blocked<br/>Transaction authority remains unchanged"]
    end

    request --> contract
    edit --> contract
    contract --> gate --> gate_check
    gate_check -- "first path missing" --> clarify
      gate_check -- "operator-owned witnesses" --> host --> candidate --> identity_check --> source_control --> candidate_author --> validator --> complete
    validator -- "invalid or tampered" --> invalid_candidate
    complete -- "no" --> clarify
    complete -- "yes" --> canonical
    canonical --> project
    canonical --> radar
    canonical --> registry
    canonical --> atlas
    canonical --> compass
    project --> seal
    radar --> seal
    registry --> seal
    atlas --> seal
    compass --> seal
    seal --> decision
    decision -- "CONFIRM" --> confirm --> readback
    decision -- "EDIT" --> revise --> contract
    decision -- "REJECT" --> reject
    canonical -. "immutable campaign input" .-> frozen --> evaluator --> qualified
    canonical -. "bounded asynchronous flow" .-> timing

    classDef evidence fill:#EFF6FF,stroke:#BFD7FE,color:#132033,stroke-width:1px;
    classDef semantic fill:#ECFDFB,stroke:#A7E9E3,color:#132033,stroke-width:1px;
    classDef governance fill:#F5F3FF,stroke:#DDD6FE,color:#132033,stroke-width:1px;
    classDef constraint fill:#FFF8E6,stroke:#F6D98B,color:#132033,stroke-width:1px;
    class request,edit,contract,gate,host,candidate,identity_check,candidate_author evidence;
    class source_control semantic;
    class validator,canonical,project,radar,registry,atlas,compass semantic;
    class seal,decision,confirm,revise,reject,readback governance;
    class frozen,evaluator,qualified governance;
    class gate_check,complete,clarify,invalid_candidate,timing constraint;

    style evidence_lane fill:#FBFDFF,stroke:#BFD7FE,stroke-width:1px,color:#293D52
    style host_lane fill:#FBFDFF,stroke:#BFD7FE,stroke-width:1px,color:#293D52
    style admission_lane fill:#F8FFFE,stroke:#A7E9E3,stroke-width:1px,color:#293D52
    style projection_lane fill:#F8FFFE,stroke:#A7E9E3,stroke-width:1px,color:#293D52
    style transaction_lane fill:#FCFBFF,stroke:#DDD6FE,stroke-width:1px,color:#293D52
    style release_lane fill:#FFFCF3,stroke:#F6D98B,stroke-width:1px,color:#293D52
    linkStyle default stroke:#9FB2C8,stroke-width:1.25px
