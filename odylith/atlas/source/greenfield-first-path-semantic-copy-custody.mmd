flowchart LR
    subgraph source_lane["Source evidence"]
      direction TB
      request["Original request and EDIT evidence<br/>Exact text retained as untrusted input"]
      source_units["Exact original source text<br/>Shared evidence for all three model roles"]
      selector["Participant selector<br/>Source-supported people with strict source locations"]
      people["Frozen participant candidate<br/>Remaining author cannot change this set"]
      model_author["Remaining-candidate author<br/>Source facts and proposed design around frozen participants"]
    end

    subgraph graph_lane["Canonical typed meaning"]
      direction TB
      facts["Deterministically joined source-cited facts<br/>Story, state, actors, systems,<br/>responsibilities and constraints"]
      events["Stable source action identities<br/>Selected performer and source-bound target<br/>No source-list chronology"]
      precedence["Source-stated prerequisites<br/>References to exact existing<br/>operational-constraint facts"]
      terminal["Source-stated proof and result producer<br/>Exact output citation when entailed<br/>No last-position requirement"]
      checkpoint["Proposed proof checkpoint<br/>One visible assumption when source has no terminal<br/>No source span, result relation or output claim"]
      design["Provisional design and first run<br/>4–5 components and workstreams<br/>Exchanges, verification and source-event support"]
      custody["Deterministic custody compiler<br/>Source proof XOR sealed proposed checkpoint<br/>Proposed order preserves required actions"]
      completeness{"Material facts and<br/>relations complete?"}
      clarify["Clarification required<br/>Material uncertainty unsafe to assume<br/>stops before persistence"]
      review["Immutable complete-candidate review<br/>Exact selected source locations<br/>One final call within the shared deadline"]
      denied["No admitted candidate<br/>No repair loop or governed write"]
      canonical["Canonical source and design<br/>Distinct authority, same relation hash"]
    end

    subgraph consumer_lane["Deterministic consumers"]
      direction TB
      project["Project story and proposed first run<br/>Release context is not the selected coding scope<br/>Required constraints and exclusions stay distinct"]
      radar["Radar proposed deliverables and acceptance<br/>Exact release membership; dependency-ready start<br/>No invented project or child workstream"]
      registry["Registry proposed logical ownership<br/>Never transfers source actor authority"]
      atlas["Atlas source context and proposed first run<br/>Distinct source and proposed arrows<br/>Exchanges, delivery dependencies and support"]
      compass["Compass decisions and proof"]
      evaluator["Release evaluator<br/>Reads the same typed relations<br/>and product-owned Mermaid parser"]
    end

    subgraph transaction_lane["Persistence law"]
      direction TB
      seal["Sealed transaction<br/>Exact projections and source custody"]
      confirm["CONFIRM is commit-only<br/>No semantic reinterpretation"]
      readback["Readback must equal<br/>the reviewed transaction"]
    end

    request --> source_units --> selector --> people --> model_author
    model_author -- "remaining facts" --> facts
    people -- "unchanged participant insertion" --> facts
    model_author --> events
    model_author --> precedence
    model_author --> terminal
    model_author --> checkpoint
    model_author --> design
    design --> custody
    facts --> custody
    events --> custody
    precedence --> custody
    terminal --> custody --> completeness
    checkpoint --> custody
    completeness -- "no" --> clarify
    completeness -- "yes" --> review
    review -- "admitted unchanged" --> canonical
    review -- "denied, unavailable or late" --> denied
    selector -- "invalid or unavailable" --> denied
    canonical --> project
    canonical --> radar
    canonical --> registry
    canonical --> atlas
    canonical --> compass
    canonical --> evaluator
    project --> seal
    radar --> seal
    registry --> seal
    atlas --> seal
    compass --> seal
    seal --> confirm --> readback
    readback -. "semantic parity" .-> evaluator

    classDef primary fill:#EFF6FF,stroke:#BFD7FE,color:#132033,stroke-width:1px;
    classDef semantic fill:#ECFDFB,stroke:#A7E9E3,color:#132033,stroke-width:1px;
    classDef governance fill:#F5F3FF,stroke:#DDD6FE,color:#132033,stroke-width:1px;
    classDef constraint fill:#FFF8E6,stroke:#F6D98B,color:#132033,stroke-width:1px;
    class request,source_units,selector,people,model_author primary;
    class facts,events,precedence,terminal,checkpoint,design,custody,review,canonical,project,radar,registry,atlas,compass,evaluator semantic;
    class seal,confirm,readback governance;
    class completeness,clarify,denied constraint;

    style source_lane fill:#FBFDFF,stroke:#BFD7FE,stroke-width:1px,color:#293D52
    style graph_lane fill:#F8FFFE,stroke:#A7E9E3,stroke-width:1px,color:#293D52
    style consumer_lane fill:#F8FFFE,stroke:#A7E9E3,stroke-width:1px,color:#293D52
    style transaction_lane fill:#FCFBFF,stroke:#DDD6FE,stroke-width:1px,color:#293D52
    linkStyle default stroke:#9FB2C8,stroke-width:1.25px
