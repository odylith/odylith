flowchart LR
    subgraph assignment["Runner-owned assignment"]
      direction TB
      evidence["Prompt or sealed EDIT evidence<br/>exact bytes and hashes"]
      contract["Materiality and graph contracts<br/>canonical fields, graph laws,<br/>one attempt and pinned host profile"]
      nonces["Independent run identities<br/>case, critic and author nonces"]
    end

    subgraph critic_lane["Prompt-only materiality critic"]
      direction TB
      critic_input["Evidence plus public materiality schema<br/>no candidate, annotations or validator feedback"]
      assessment["Nine-field materiality assessment<br/>explicit, source-entailable,<br/>non-material assumption or unresolved"]
      decision{"Authorize graph?"}
      clarification["One focused material question<br/>no authority is sealed"]
    end

    subgraph author_lane["Independent graph author"]
      direction TB
      author_input["Evidence plus sealed assessment<br/>fresh isolated context"]
      structured_output["Provider-constrained bounded extension<br/>node facts plus node-owned typed targets<br/>no authored edge subject, kind or custody"]
      graph_assembly["Deterministic graph assembly<br/>locked source facts plus projected edges<br/>one canonical Semantic Intent"]
      deterministic_checks["Deterministic validation<br/>exact citation bytes, graph endpoints,<br/>ownership, polarity, cardinality,<br/>materiality alignment and stable hashes"]
      authority["Verified Product Intent authority<br/>model output is admitted only after every law passes"]
    end

    evidence --> critic_input
    contract --> critic_input
    nonces --> critic_input
    critic_input --> assessment --> decision
    decision -- "no" --> clarification
    clarification -- "new EDIT evidence" --> evidence
    decision -- "yes" --> author_input
    evidence --> author_input
    contract --> author_input
    nonces --> author_input
    author_input --> structured_output --> graph_assembly --> deterministic_checks
    deterministic_checks -- "invalid" --> clarification
    deterministic_checks -- "valid" --> authority

    classDef assignment fill:#EFF6FF,stroke:#60A5FA,color:#132033,stroke-width:1.2px;
    classDef critic fill:#FFF7ED,stroke:#FB923C,color:#132033,stroke-width:1.2px;
    classDef author fill:#F0FDF4,stroke:#4ADE80,color:#132033,stroke-width:1.2px;
    class evidence,contract,nonces assignment;
    class critic_input,assessment,decision,clarification critic;
    class author_input,structured_output,graph_assembly,deterministic_checks,authority author;

    style assignment fill:#FBFDFF,stroke:#60A5FA,stroke-width:1px,color:#293D52
    style critic_lane fill:#FFFBF5,stroke:#FB923C,stroke-width:1px,color:#293D52
    style author_lane fill:#F8FFF9,stroke:#4ADE80,stroke-width:1px,color:#293D52
    linkStyle default stroke:#9FB2C8,stroke-width:1.25px
