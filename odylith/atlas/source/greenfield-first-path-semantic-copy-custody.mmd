flowchart TB
    source["Request or EDIT<br/>Retain exact source and accepted owners"]
    gate{"Owner, usable task<br/>and observable result?"}
    question["Ask one focused question<br/>No project created"]
    inventory["Inventory and citation preflight<br/>Check actors, actions and outside participants"]
    verifier["Source-only verification<br/>Complete run, order, result and proof;<br/>keep declared path and system consequences"]
    candidate["One design candidate<br/>Allocate components; preserve source meaning"]
    admission["Deterministic admission<br/>Check facts, relations, guards and EDIT owners;<br/>context gives no product authority"]
    refusal["Refuse invalid output<br/>No repair or retry"]
    completion["Seal and complete preparation<br/>Build governance views; deliver completion receipt;<br/>no further semantic calls"]
    decision{"User confirms with<br/>the delivered receipt?"}
    defer["EDIT or reject<br/>No governed writes"]
    publish["Publish the sealed bytes<br/>Readback repeats fact-context checks"]

    source --> gate
    gate -- "yes" --> inventory --> verifier --> candidate --> admission --> completion --> decision
    gate -- "material gap" --> question
    inventory -- "material question" --> question
    inventory -- "invalid" --> refusal
    verifier -- "invalid" --> refusal
    admission -- "invalid" --> refusal
    decision -- "yes" --> publish
    decision -- "no" --> defer

    classDef evidence fill:#EFF6FF,stroke:#BFD7FE,color:#132033,stroke-width:1px;
    classDef meaning fill:#ECFDFB,stroke:#A7E9E3,color:#132033,stroke-width:1px;
    classDef custody fill:#F5F3FF,stroke:#DDD6FE,color:#132033,stroke-width:1px;
    classDef choice fill:#FFF8E6,stroke:#F6D98B,color:#132033,stroke-width:1px;
    class source,inventory,candidate evidence;
    class verifier,admission meaning;
    class completion,publish custody;
    class gate,question,refusal,decision,defer choice;
    linkStyle default stroke:#9FB2C8,stroke-width:1.25px
