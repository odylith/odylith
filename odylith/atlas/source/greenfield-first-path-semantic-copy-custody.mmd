flowchart LR
    subgraph intent_lane["Accepted First-Path Facts"]
      direction TB
      accepted_path["Accepted first path<br/>operator-confirmed behavior"]
      prompt_material_custody["Prompt material custody<br/>internally synthesized confirmations only<br/>restore lost source steps;<br/>operator edits stay authoritative"]
      actor_roles["Shared actor-role owner<br/>role nouns normalized once<br/>for recovery, fragments, and signatures"]
      actor_recovery["Actor recovery owner<br/>finite action leads stay actions,<br/>not plural actor subjects"]
      actor_path_role["Actor path-role owner<br/>accepted-path descriptions,<br/>title-suffix subject stripping,<br/>preposition/action-led role cleanup"]
      subject_carry_guard["Explicit subject-carry guard<br/>one-word human actors stay actors,<br/>visible result objects do not<br/>become sibling subjects"]
      purpose_context["Purpose-context owner<br/>semicolon-led accepted context<br/>carries into first actionable step"]
      action_boundary["Action-boundary owner<br/>ordinary leading actions stay actions,<br/>finite sibling actions split events"]
      semantic_contract["SemanticModelIR first-path contract<br/>events, visible result,<br/>proof obligations"]
      external_boundary["External boundary facts<br/>explicit system rows,<br/>inferred interaction,<br/>or deferred fixture/manual boundary"]
      sequence_owner["Sequence step owner<br/>keeps connector-led object tails,<br/>evidence noun compounds,<br/>and distinctive terminal event terms"]
      tail_custody["Action-complement and object-list custody<br/>semantic tail fallback restores<br/>accepted event terms before compact labels"]
      visible_result_owner["Visible-result owner<br/>quoted/bounded result objects,<br/>saved-as generic result targets,<br/>and reviewable outcomes outrank broad display lists"]
      modal_owner["Modal actor owner<br/>plural actors keep can<br/>plus base action"]
    end

    subgraph prose_lane["Generated Prose Shape"]
      direction TB
      shape_checks["Prose-shape checks<br/>actor-led capability drift,<br/>clause-local gerund actor splice,<br/>title-compound user-role allowance"]
      gerund_owner["Gerund action owner<br/>bounded proof-action phrasing"]
      actor_role_head_guard["Actor-role head guard<br/>shared role nouns only,<br/>object words do not become actors"]
      structural_filter["Structural-copy filter<br/>ids, paths, slugs,<br/>versions, URLs"]
      repetition_gate["Semantic repetition gate<br/>allows sanctioned canonical facts,<br/>rejects unowned repeated tails<br/>and emits occurrence metadata<br/>for repeated package prose"]
    end

    subgraph projection_lane["Surface Projections"]
      direction TB
      radar_projection["Radar and brief projection<br/>surface-local wording"]
      state_boundary_titles["State-boundary title owner<br/>compact review/action focus,<br/>no changes-it pronoun tail,<br/>no duplicate clarity word"]
      actor_choice_copy["Project-brief actor choices<br/>neutral participant wording,<br/>no category echo"]
      atlas_projection["Atlas event projection<br/>sequence and flow labels"]
      mermaid_label_custody["Mermaid label custody<br/>visible line breaks avoid<br/>dangling connector words;<br/>header/body labels do not repeat<br/>fixed result wrappers"]
      label_action_grammar["Shared action grammar for labels<br/>coordinated finite actions become<br/>imperative base actions before render"]
      next_step_prompts["Project next-step prompts<br/>accepted first path preserved,<br/>no Radar slice echo"]
      overlap_projection["Next-step overlap projection<br/>raw path, capability,<br/>visible result, events only"]
      artifact_units["ArtifactQualityUnit collector<br/>keeps metadata, commands,<br/>prompt fields, Mermaid labels,<br/>and free prose separate"]
      mermaid_label_gate["Mermaid label quality gate<br/>rejects mixed finite/base action labels;<br/>preserves noun coordinations"]
      mermaid_source_units["Mermaid source custody<br/>source fields become visible-label units<br/>before prose quality checks"]
      canonical_facts["Canonical projection facts<br/>full events, sequence-step variants,<br/>and compact tails carry semantic node,<br/>source path, projection id, sanctioned surfaces"]
      tribunal_actors["Tribunal visible actors<br/>actor_source provenance,<br/>typed operator evidence,<br/>role-specific generated labels,<br/>shared label custody,<br/>persisted readback checked"]
      evaluation_readback["Scientific evaluation readback<br/>typed IR-derived obligations:<br/>method/protocol, baseline/comparison,<br/>uncertainty/tolerance, reproducibility"]
      package_findings["Typed package findings<br/>source path, projection id,<br/>repair owner,<br/>occurrence paths and counts"]
    end

    subgraph repair_lane["Repair Custody"]
      direction TB
      semantic_plan_patch["Semantic or plan patch<br/>source fact repair only"]
      source_address["ProjectionSourceAddress<br/>plan patches require exact<br/>ArtifactPlanIR field, row field,<br/>or owned list fact;<br/>broad roots fail closed"]
      projection_repair_targets["Projection-source repair targets<br/>preview leaves resolve to<br/>SemanticModelIR or ArtifactPlanIR"]
      dashboard_rerender["Project dashboard rerender<br/>source previews rebuild dashboard,<br/>not rendered body patches"]
      package_inspection["Read-only package inspection<br/>duplicate words, dangling tails,<br/>and cross-artifact repetition stay source-owned<br/>until SemanticModelIR or ArtifactPlanIR is repaired"]
      final_gate["Final package gate<br/>same validators, no lowered bar"]
      governed_write["Governed writes<br/>only after manifest passes"]
    end

    accepted_path --> prompt_material_custody
    prompt_material_custody --> actor_roles
    actor_roles --> actor_recovery
    actor_recovery --> actor_path_role
    actor_path_role --> subject_carry_guard
    subject_carry_guard --> purpose_context
    purpose_context --> action_boundary
    action_boundary --> semantic_contract
    semantic_contract --> evaluation_readback
    semantic_contract --> external_boundary
    external_boundary --> sequence_owner
    sequence_owner --> tail_custody
    tail_custody --> visible_result_owner
    visible_result_owner --> modal_owner
    modal_owner --> radar_projection
    modal_owner --> atlas_projection
    modal_owner --> next_step_prompts
    radar_projection --> state_boundary_titles
    state_boundary_titles --> actor_choice_copy
    radar_projection --> shape_checks
    atlas_projection --> mermaid_label_custody
    mermaid_label_custody --> label_action_grammar
    label_action_grammar --> shape_checks
    actor_choice_copy --> artifact_units
    next_step_prompts --> overlap_projection
    overlap_projection --> artifact_units
    artifact_units --> mermaid_label_gate
    mermaid_label_gate --> mermaid_source_units
    mermaid_source_units --> canonical_facts
    canonical_facts --> tribunal_actors
    tribunal_actors --> shape_checks
    shape_checks --> gerund_owner
    gerund_owner --> actor_role_head_guard
    actor_role_head_guard --> structural_filter
    structural_filter --> repetition_gate
    canonical_facts --> repetition_gate
    repetition_gate --> package_findings
    evaluation_readback --> package_findings
    package_findings --> projection_repair_targets
    projection_repair_targets --> source_address
    source_address --> semantic_plan_patch
    semantic_plan_patch --> dashboard_rerender
    package_findings --> package_inspection
    dashboard_rerender --> final_gate
    package_inspection --> final_gate
    final_gate --> governed_write

    classDef intent fill:#EFF6FF,stroke:#BFD7FE,color:#17233A,stroke-width:1px;
    classDef prose fill:#F8FAFC,stroke:#CBD5E1,color:#17233A,stroke-width:1px;
    classDef projection fill:#ECFDFB,stroke:#A7E9E3,color:#17233A,stroke-width:1px;
    classDef repair fill:#FFF7ED,stroke:#FDBA74,color:#17233A,stroke-width:1px;
    class accepted_path,prompt_material_custody,actor_roles,actor_recovery,actor_path_role,subject_carry_guard,purpose_context,action_boundary,semantic_contract,external_boundary,sequence_owner,tail_custody,visible_result_owner,modal_owner intent;
    class shape_checks,gerund_owner,actor_role_head_guard,structural_filter,repetition_gate prose;
    class radar_projection,state_boundary_titles,actor_choice_copy,atlas_projection,mermaid_label_custody,label_action_grammar,next_step_prompts,overlap_projection,artifact_units,mermaid_label_gate,mermaid_source_units,canonical_facts,tribunal_actors,evaluation_readback,package_findings projection;
    class semantic_plan_patch,source_address,projection_repair_targets,dashboard_rerender,package_inspection,final_gate,governed_write repair;

    style intent_lane fill:#FBFDFF,stroke:#BFD7FE,stroke-width:1px,color:#334155
    style prose_lane fill:#FBFDFF,stroke:#CBD5E1,stroke-width:1px,color:#334155
    style projection_lane fill:#F8FFFE,stroke:#A7E9E3,stroke-width:1px,color:#334155
    style repair_lane fill:#FFFBF5,stroke:#FDBA74,stroke-width:1px,color:#334155
