flowchart LR
    subgraph evidence_lane["Operator evidence"]
      direction TB
      request["Original request<br/>Retained as untrusted evidence"]
      edit["EDIT correction<br/>Bound to the retained sealed source"]
      contract["Candidate contract<br/>Public typed schema and sealed source context"]
    end

    subgraph host_lane["Host-native semantic authoring"]
      direction TB
      host["Active host reasoning<br/>One compact complete candidate"]
      candidate["Typed candidate<br/>Complete cited events and component support<br/>plus one proposed coherent branch"]
    end

    subgraph admission_lane["Deterministic admission"]
      direction TB
      validator["Deterministic validator and custody compiler<br/>Complete event custody; selected terminal,<br/>predecessors and branch order"]
      complete{"Complete and<br/>source-grounded?"}
      clarify["One focused clarification<br/>No review, package or governed write"]
      review["Independent tri-state review<br/>Distinguishes required sequence<br/>from alternate outcomes"]
      review_clarify["Reviewer-selected material clarification<br/>Retain review receipt; one focused question<br/>No package or governed write"]
      denied["Denied after completed review<br/>Retain exact candidate and review receipt<br/>No repair, retry, or fallback ladder"]
      review_failure["Reviewer unavailable or late<br/>Fail closed; retain attempt and failure custody only<br/>No review receipt or governed write"]
      canonical["Canonical Product Intent envelope<br/>Reviewed candidate admitted unchanged"]
    end

    subgraph projection_lane["Deterministic governance projections"]
      direction TB
      project["Project story and one coherent first run<br/>Alternate events remain retained"]
      radar["4–5 grounded Radar workstreams"]
      registry["4–5 Registry components"]
      atlas["5+ detailed Atlas diagrams<br/>Typed performer-to-event relations preserved"]
      compass["Compass decisions and proof"]
    end

    subgraph transaction_lane["Sealed transaction"]
      direction TB
      seal["Sealed transaction<br/>Exact projections, custody and review receipt"]
      decision{"Operator decision"}
      confirm["CONFIRM<br/>Commit-only publication"]
      revise["EDIT<br/>New candidate contract from old seal + correction"]
      reject["REJECT<br/>No governed writes"]
      readback["Readback equals reviewed bytes"]
    end

    request --> contract
    edit --> contract
    contract --> host --> candidate --> validator --> complete
    complete -- "no" --> clarify
    complete -- "yes" --> review
    review -- "admitted unchanged" --> canonical
    review -- "material source gap" --> review_clarify
    review -- "source-sufficient semantic defect" --> denied
    review -- "unavailable or late" --> review_failure
    canonical --> project
    canonical --> radar
    canonical --> registry
    canonical --> atlas
    canonical --> compass
    project --> seal
    radar --> seal
    registry --> seal
    atlas --> seal
    compass --> seal
    seal --> decision
    decision -- "CONFIRM" --> confirm --> readback
    decision -- "EDIT" --> revise --> contract
    decision -- "REJECT" --> reject

    classDef evidence fill:#EFF6FF,stroke:#BFD7FE,color:#132033,stroke-width:1px;
    classDef semantic fill:#ECFDFB,stroke:#A7E9E3,color:#132033,stroke-width:1px;
    classDef governance fill:#F5F3FF,stroke:#DDD6FE,color:#132033,stroke-width:1px;
    classDef constraint fill:#FFF8E6,stroke:#F6D98B,color:#132033,stroke-width:1px;
    class request,edit,contract,host,candidate evidence;
    class validator,review,canonical,project,radar,registry,atlas,compass semantic;
    class seal,decision,confirm,revise,reject,readback governance;
    class complete,clarify,review_clarify,denied,review_failure constraint;

    style evidence_lane fill:#FBFDFF,stroke:#BFD7FE,stroke-width:1px,color:#293D52
    style host_lane fill:#FBFDFF,stroke:#BFD7FE,stroke-width:1px,color:#293D52
    style admission_lane fill:#F8FFFE,stroke:#A7E9E3,stroke-width:1px,color:#293D52
    style projection_lane fill:#F8FFFE,stroke:#A7E9E3,stroke-width:1px,color:#293D52
    style transaction_lane fill:#FCFBFF,stroke:#DDD6FE,stroke-width:1px,color:#293D52
    linkStyle default stroke:#9FB2C8,stroke-width:1.25px
