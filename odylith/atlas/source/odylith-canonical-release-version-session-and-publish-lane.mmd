%% Reviewed 2026-10-12 for one prepared release package, public-family qualification, and a single terminal completion attempt.
flowchart TD
    maintainer["Maintainer Workspace"]
    preview["release-version-preview / release-version-show"]
    devvalidate["dev-validate<br/>detached source-local lane<br/>fresh-process pytest shards"]
    prepare["release-preflight --prepare<br/>seal one release package"]
    session["Prepared release package<br/>version, commit, distribution<br/>and immutable public references"]
    primary["Primary public family<br/>40 prompts"]
    high_variance["High-variance public family<br/>4 prompts"]
    genuine_edit["Genuine EDIT public family<br/>4 lifecycle cases"]
    composition["Composed qualification gate<br/>authenticate one package<br/>and each family result"]
    complete["release-preflight --complete<br/>one terminal attempt"]
    holdout["Protected terminal holdout<br/>runs once after qualification"]
    dispatch["release-dispatch"]
    isolated["Isolated clean checkout<br/>detached at origin/main when needed"]

    subgraph local["Local Canonical Release Lane"]
        preview --> prepare --> session
        session --> primary --> composition
        session --> high_variance --> composition
        session --> genuine_edit --> composition
        composition --> complete --> holdout --> dispatch
    end

    subgraph dev["Maintainer Dev Lane"]
        devvalidate --> preview
    end

    subgraph guards["Canonical Lane Guards"]
        origin["origin = odylith/odylith"]
        actor["gh auth = freedom-research"]
        sync["workspace HEAD = origin/main"]
        clean["proof checkout = clean"]
        detached["wrapper may materialize<br/>isolated clean checkout"]
    end

    subgraph publish["GitHub Release Workflow"]
        workflow["release.yml"]
        commit_guard["verify tag + expected_sha + GITHUB_SHA"]
        posture["validate self-host-posture --mode release"]
        build["build wheel"]
        assets["publish install.sh + manifest + provenance + SBOM"]
    end

    subgraph proof["Post-Publish Proof"]
        dogfood["dogfood-activate"]
        consumer["consumer-rehearsal"]
        ga["ga-gate"]
    end

    maintainer --> preview
    maintainer --> devvalidate
    maintainer --> origin
    maintainer --> actor
    maintainer --> sync
    maintainer --> detached
    detached --> isolated
    isolated --> clean

    origin --> prepare
    actor --> prepare
    clean --> prepare
    sync --> prepare

    dispatch --> workflow
    session --> workflow
    workflow --> commit_guard
    commit_guard --> posture
    posture --> build
    build --> assets

    assets --> dogfood
    assets --> consumer
    dogfood --> ga
    consumer --> ga
