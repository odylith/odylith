flowchart TB
    operator["Operator command<br/>install / upgrade / reinstall / doctor"]
    resolver["Resolve target release<br/>version, manifest, schema, verification inputs"]
    classifier["Repo scenario classifier<br/>pin, launcher, state, runtime pointer, ledger, source-local, legacy roots"]
    noop["Verified same-version reinstall<br/>already-current no-op only when<br/>previous == target + runtime verified"]
    registry["Migration registry<br/>MigrationDefinition contracts"]
    planner["MigrationPlan<br/>selected, skipped, blocked, satisfied-unrecorded, ledger-stale"]
    dryrun["Dry-run and JSON report<br/>scenario, write set, rollback scope, plan fingerprint"]
    apply["Upgrade/apply execution<br/>uses the same plan"]
    ledger["Durable migration ledger<br/>predicate evidence, planned/actual writes, verification"]
    doctor["Doctor observability<br/>pending, blocked, stale, repair-only cleanup"]
    release["Release migration-gate command<br/>caller verifies published predecessor"]
    scope["Consumer-surface comparison<br/>resolved predecessor and candidate trees<br/>plus visible local changes"]
    assessment["Exact completed Radar assessment<br/>target, predecessor, paths, modes and contents"]
    gate["Release-only validation owner<br/>manifest coverage, fixtures, bypass scan<br/>and migration assessment"]
    block["Fail closed before runtime mutation"]
    release_block["Release approval refused<br/>no consumer writes"]
    surfaces["Post-upgrade surfaces<br/>dashboard refresh is separate from migration"]

    operator --> resolver --> classifier
    classifier -->|"release transition or repair state"| registry --> planner
    classifier -->|"verified same-version reinstall"| noop --> planner
    classifier -->|"missing runtime verification"| planner
    planner --> dryrun
    planner --> apply
    planner --> doctor
    release --> scope --> assessment --> gate
    registry --> gate
    scope -->|"Git unavailable or tracked content hidden"| release_block
    planner -->|"blocked or ledger_stale"| block
    apply -->|"selected automatic migration"| ledger
    apply -->|"satisfied_unrecorded"| ledger
    apply --> surfaces
    gate -->|"missing definition, fixture, assessment or direct bypass"| release_block
