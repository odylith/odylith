%% Current authority and useful history share one Context Engine policy; tracked truth remains authoritative.
flowchart TB
    Truth["Tracked product truth<br/>Radar + Plans + Casebook + Registry + Atlas + guidance"] --> Compiler["Context Engine compiler/store<br/>projection build + retained packet assembly"]

    subgraph ReadModels["1. Compiler-owned read models"]
        RecordPolicy["Shared memory record policy<br/>source refs + evidence time + derivation<br/>current truth / historical learning / observation"]
        Bundle["Projection Bundle<br/>manifest + documents.v1.jsonl + edges.v1.jsonl"]
        Snapshot["Projection Snapshot<br/>projection-snapshot.v1.json"]
    end

    subgraph Retrieval["2. Retrieval and memory lanes"]
        Backend["Memory Backend<br/>LanceDB + Tantivy + judgment memory"]
        Remote["Remote Retrieval<br/>optional Vespa augment / remote_only"]
        Selection["Evidence selection<br/>admit authority and validity first<br/>then relevance, evidence and age"]
        Continuity["Judgment continuity<br/>verify current source and derivation<br/>before raising routing confidence"]
    end

    subgraph Contracts["3. Packet-safe memory contract"]
        MemoryContracts["Memory Contracts<br/>allowlist + redaction + compaction + execution-profile tokens"]
        SessionStream["Session stream contract<br/>recent turns + host family + model family<br/>proof events + user corrections"]
        DeliveryLedger["Delivery ledger contract<br/>ambient + Observation + Proposal + Assist<br/>generated / fallback-ready / chat-confirmed"]
    end

    subgraph State["4. Derived runtime state"]
        CompilerState[".odylith/runtime/odylith-compiler<br/>bundle + snapshot artifacts"]
        MemoryState[".odylith/runtime/odylith-memory<br/>lance + tantivy + judgment memory + remote sync"]
        SessionState[".odylith/runtime/session-streams<br/>cached hot-path summaries"]
    end

    subgraph Consumers["5. Runtime consumers"]
        Governance["Delivery Intelligence + governed surfaces"]
        Tribunal["Tribunal + Remediator"]
        Execution["Execution Engine<br/>compact snapshot reuse"]
        Intervention["Visible Intervention Broker<br/>Context + Execution + Memory + Tribunal decision"]
        Benchmark["Benchmark proof<br/>recall and accuracy before latency budget"]
        Conversation["Router + Orchestrator + Odylith Chatter"]
    end

    Compiler --> RecordPolicy
    RecordPolicy --> Bundle
    RecordPolicy --> Snapshot
    Bundle --> Backend
    Bundle --> Remote
    Bundle --> Selection
    Snapshot --> Selection
    Backend --> Selection
    Remote --> Selection
    RecordPolicy -. same policy .-> Selection
    Selection --> MemoryContracts
    Backend --> Continuity
    RecordPolicy -. same admission .-> Continuity
    Continuity --> MemoryContracts
    MemoryContracts --> SessionStream
    SessionStream --> DeliveryLedger
    Bundle --> CompilerState
    Snapshot --> CompilerState
    Backend --> MemoryState
    Remote --> MemoryState
    SessionStream --> SessionState
    DeliveryLedger --> SessionState
    MemoryContracts --> Governance
    MemoryContracts --> Tribunal
    MemoryContracts --> Execution
    SessionStream --> Execution
    DeliveryLedger --> Intervention
    Execution --> Intervention
    Tribunal --> Intervention
    MemoryContracts --> Benchmark
    SessionStream --> Benchmark
    MemoryContracts --> Conversation
    Remote -. opt-in .-> Governance
