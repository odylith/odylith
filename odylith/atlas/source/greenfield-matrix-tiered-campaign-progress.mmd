flowchart TB
    subgraph frozen_inputs["Evidence frozen before authoring"]
      direction LR
      revision["Frozen implementation fingerprint"]
      contracts["Authoring, materiality, graph,<br/>mechanism and evaluator contract hashes"]
      corpus["Blinded development corpus<br/>case hashes only"]
      plan["Runner-owned evidence plan<br/>host assignments, nonces,<br/>resource ceilings and deterministic laws"]
    end

    subgraph per_case["Three-call standard plus bounded selection-only rescue"]
      direction LR
      critic["Prompt-only critic<br/>one attempt, no tools or prior candidate"]
      full_author["Full-source graph author<br/>one attempt, no validator feedback"]
      source_author["Source-only graph author<br/>independent evidence view"]
      receipts["Runtime receipts<br/>binary hash, model profile,<br/>tokens, wall time and access claims"]
      candidates["Two typed candidates<br/>each admitted through<br/>the same graph and package laws"]
      selector["Optional fourth call<br/>select existing candidate<br/>or clarify; no graph authorship"]
      packet["Complete packet<br/>assessment, selected graph,<br/>challenges and hashes"]
      transaction["Graph-native transaction proof<br/>or one material clarification"]
    end

    subgraph independent_proof["Independent development adjudication"]
      direction LR
      fidelity["Semantic fidelity<br/>facts, relations, polarity,<br/>unsupported additions and omissions"]
      utility["Package utility<br/>component differentiation,<br/>surface retention and equivalent-source behavior"]
      resources["Mechanism cost<br/>latency, tokens, calls,<br/>complexity and recoverability"]
      decision{"Zero P0 or P1<br/>and every threshold met?"}
    end

    subgraph release_gates["Release evidence after development is clean"]
      direction LR
      parity["Codex and Claude parity<br/>same public graph and transaction laws"]
      lower["Lower-capability safety<br/>clarify or fail safe only"]
      install["Fresh distribution and clean install"]
      browser["Normal, empty and degraded browser proof"]
      holdout["Protected holdout<br/>opened and run exactly once, last"]
    end

    revision --> plan
    contracts --> plan
    corpus --> plan
    plan --> critic
    plan --> full_author
    plan --> source_author
    critic --> receipts
    full_author --> receipts
    source_author --> receipts --> candidates
    candidates --> selector
    candidates --> packet
    selector --> packet --> transaction
    transaction --> fidelity --> utility --> resources --> decision
    decision -- "no" --> revision
    decision -- "yes" --> parity --> lower --> install --> browser --> holdout

    classDef frozen fill:#EFF6FF,stroke:#60A5FA,color:#132033,stroke-width:1.2px;
    classDef run fill:#F8FAFC,stroke:#94A3B8,color:#132033,stroke-width:1.2px;
    classDef proof fill:#FFF7ED,stroke:#FB923C,color:#132033,stroke-width:1.2px;
    classDef release fill:#F0FDF4,stroke:#4ADE80,color:#132033,stroke-width:1.2px;
    class revision,contracts,corpus,plan frozen;
    class critic,full_author,source_author,receipts,candidates,selector,packet,transaction run;
    class fidelity,utility,resources,decision proof;
    class parity,lower,install,browser,holdout release;

    style frozen_inputs fill:#FBFDFF,stroke:#60A5FA,stroke-width:1px,color:#293D52
    style per_case fill:#FBFDFF,stroke:#94A3B8,stroke-width:1px,color:#293D52
    style independent_proof fill:#FFFBF5,stroke:#FB923C,stroke-width:1px,color:#293D52
    style release_gates fill:#F8FFF9,stroke:#4ADE80,stroke-width:1px,color:#293D52
    linkStyle default stroke:#9FB2C8,stroke-width:1.25px
