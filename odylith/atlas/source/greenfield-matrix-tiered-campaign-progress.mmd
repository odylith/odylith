%% Atlas visual contract: show the release decision, not harness internals.
flowchart TB
    sources["Disclosed source prompts<br/>and independent preannotations"]
    discovery["Public diagnostic discovery<br/>retains each outcome"]
    retained_failures["Retained failures<br/>stay available for repair and review"]
    nonrelease["Discovery result<br/>is not release qualification"]

    prepare["Prepare one release package<br/>distribution and immutable references"]
    package["Sealed package<br/>the only package each family may use"]

    subgraph families["Public qualification families"]
      direction LR
      primary["Primary family<br/>40 prompts"]
      high["High-variance family<br/>4 prompts"]
      edit_gate["Genuine EDIT gate<br/>requires complete prior lifecycle evidence"]
      genuine["Genuine EDIT family<br/>4 cases"]
    end

    semantic["Independent semantic review<br/>checks source fidelity"]
    timing["Per-family timing decision<br/>uses retained measured evidence"]
    composition["Composed public qualification<br/>authenticates original package<br/>and every family reference"]
    holdout["Protected terminal holdout<br/>one attempt after qualification"]
    final_review["Independent final review and dispatch<br/>reauthenticate the same references"]

    sources --> discovery
    sources --> prepare --> package
    discovery --> retained_failures
    discovery --> nonrelease
    retained_failures -. "repair before a new package" .-> prepare

    package --> primary
    package --> high
    package --> edit_gate --> genuine
    primary --> semantic
    high --> semantic
    genuine --> semantic
    primary --> timing
    high --> timing
    genuine --> timing
    semantic --> composition
    timing --> composition
    composition --> holdout --> final_review

    classDef input fill:#EFF6FF,stroke:#BFD7FE,color:#132033,stroke-width:1px;
    classDef execution fill:#ECFDFB,stroke:#A7E9E3,color:#132033,stroke-width:1px;
    classDef evidence fill:#F5F3FF,stroke:#DDD6FE,color:#132033,stroke-width:1px;
    classDef constraint fill:#FFF8E6,stroke:#F6D98B,color:#132033,stroke-width:1px;
    classDef retained fill:#FFF1F0,stroke:#F7B4AE,color:#132033,stroke-width:1px;
    class sources,discovery input;
    class prepare,package,primary,high,edit_gate,genuine execution;
    class semantic,timing,composition,final_review evidence;
    class nonrelease,holdout constraint;
    class retained_failures retained;
    style families fill:#FBFDFF,stroke:#A7E9E3,stroke-width:1px,color:#293D52
    linkStyle default stroke:#B9C7D8,stroke-width:1.25px
