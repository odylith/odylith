%% Reviewed 2026-04-10 for B-025 to make the governed Compass refresh and brief contract substrate-first, delta-first, daemon-backed, and zero-foreground-provider.
%% 2026-09-10 CB-305: detached request custody, native worker identity and guarded immutable publication; installed recovery remains unqualified.
flowchart TB
  subgraph Entry["1. Operator Entry"]
    CLI["odylith compass refresh<br/>odylith compass watch-transactions"]
    OneLane["One bounded Compass contract only<br/>no second deep lane"]
  end

  subgraph Detect["2. Change Detection"]
    Push["Preferred: daemon waits on projection change"]
    LocalWatch["Fallback: local watcher"]
    Coarse["Last resort: coarse poll only when no real watcher exists"]
    Fingerprint{"Projection fingerprint changed?"}
    NoChange["No change -> return current daemon-held payload"]
  end

  subgraph Runtime["3. Local Runtime Thinking"]
    HotReuse{"Daemon already has matching runtime payload?"}
    Hot["Hot path reuse<br/>in-memory payload -> current snapshot"]
    Cold["Cold local rebuild"]
    DAG["Incremental runtime DAG<br/>projection inputs -> activity -> execution projection -> window facts -> runtime payload"]
    NoProvider["Blocking path provider spend = 0"]
  end

  subgraph Substrate["4. Narration Substrate"]
    Build["Build deterministic narration substrate per entry"]
    Budget["Hard local budgets<br/>global 8-12 facts<br/>scoped 3-4 facts"]
    Delta["Compute delta vs previous accepted substrate"]
    Worth{"Worth calling provider?"}
    CacheHit["Exact substrate cache replay"]
    Skip["Skip provider explicitly<br/>skipped_not_worth_calling"]
    Inline["Pure foreground result projection<br/>enclosing refresh owns publication"]
  end

  subgraph Provider["5. Background Narration"]
    Enqueue["Enqueue one packet-level bundle"]
    Identity["Verify native worker arguments and loaded epoch<br/>unknown identity cannot authorize replacement"]
    Cached{"Exact detached result already cached?"}
    Bundle["One provider bundle<br/>global + verified scoped entries together"]
    Repair["One subset repair max"]
    Salvage["Persist valid entries immediately<br/>salvage partial good output"]
    Diagnostics["Bound provider diagnostics<br/>explicit state and debug artifacts"]
    Backoff["Record failures and retry deadline<br/>poll request identity cheaply until due"]
  end

  subgraph Publication["6. Result Publication"]
    Lease{"Repository writer lock acquired?"}
    Busy["Keep request and computed cache<br/>retry after the competing writer"]
    Patch{"Runtime fingerprint still current?"}
    PatchYes["Write matching JSON and JavaScript<br/>seal a complete immutable successor"]
    Publish["Advance the canonical dashboard entry"]
    Consume["Consume only the exact processed request<br/>retain a newer foreground request"]
    PatchNo["Do not replace newer runtime truth<br/>keep exact cached results reusable"]
    Failure["Preserve the selected complete generation and failure evidence<br/>never roll back an observed successor"]
  end

  subgraph LogCompletion["7. Canonical Log Completion"]
    Log["odylith compass log<br/>canonical stream in an active generation"]
    Admit["Admitted repository writer<br/>record exact custody before append"]
    Append["Append and fsync the original event once"]
    LogRefresh["Existing captured foreground refresh"]
    Terminal{"Exact originating terminal result?"}
    Handled["Recorded failed checkpoint<br/>retain original event and published view"]
    Rendered["Rendered custody<br/>retain even after late capture teardown error"]
    Complete["odylith compass log --complete<br/>verify receipt, inputs and exact working bytes"]
    LogPublish["Existing generation owner seals and publishes<br/>retire the exact completion receipt"]
    Refuse["Refuse unknown interruption or changed custody<br/>never replay the append or adopt historical drift"]
  end

  subgraph Guardrails["8. Product Guardrails"]
    Truth["LLM writes, local code thinks"]
    Rules["No raw-packet prompting<br/>no per-scope provider fanout<br/>no fuzzy/non-exact replay<br/>no synthetic fallback narration"]
    Targets["Targets<br/>hot daemon refresh < 50ms median<br/>cold shell-safe refresh < 1s median"]
  end

  CLI --> OneLane --> Push
  OneLane --> LocalWatch
  OneLane --> Coarse
  Push --> Fingerprint
  LocalWatch --> Fingerprint
  Coarse --> Fingerprint
  Fingerprint -->|No| NoChange --> HotReuse
  Fingerprint -->|Yes| HotReuse
  HotReuse -->|Yes| Hot --> NoProvider
  HotReuse -->|No| Cold --> DAG --> NoProvider
  NoProvider --> Build --> Budget --> Delta --> Worth
  Worth -->|Exact match| CacheHit
  Worth -->|No winner change| Skip
  Worth -->|Meaningful change| Enqueue --> Identity --> Cached
  Cached -->|Yes| Lease
  Cached -->|No| Bundle --> Repair --> Salvage --> Diagnostics --> Backoff --> Lease
  Lease -->|No| Busy
  Lease -->|Yes| Patch
  Patch -->|Yes| PatchYes
  Patch -->|No| PatchNo
  PatchYes --> Publish --> Consume
  PatchYes -->|Write or seal fails| Failure
  Publish -->|Publication fails| Failure
  CacheHit --> Inline
  Skip --> Inline

  Log --> Admit --> Append --> LogRefresh --> Terminal
  Terminal -->|Owned failure| Handled --> Complete
  Terminal -->|Owned success| Rendered --> LogPublish
  Terminal -->|Missing or foreign| Refuse
  Complete -->|Handled failure, unchanged anchors| LogRefresh
  Complete -->|Already rendered or sealed| LogPublish
  Complete -->|Absent receipt or changed inputs| Refuse
  LogPublish -->|Failure| Failure

  OneLane --> Truth
  OneLane --> Rules
  OneLane --> Targets

  classDef note fill:#FBFDFF,stroke:#D8E5F4,color:#132033
