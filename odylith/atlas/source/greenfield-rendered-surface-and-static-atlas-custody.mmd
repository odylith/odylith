flowchart LR
    verified_graph["Verified Semantic Intent graph<br/>typed facts, relations and citations"]
    projection_plan["Persisted projection plan<br/>release systems, artifact depth,<br/>workstreams, components and diagrams"]

    subgraph adaptive_depth["Graph-derived artifact depth"]
      direction TB
      workstreams["Radar plan<br/>one product row for one component;<br/>product plus component rows for plural boundaries"]
      components["Registry component packages<br/>exact implemented facts and typed interfaces;<br/>connected supporting systems may be result-less"]
      diagrams["Atlas views<br/>first path always;<br/>context, state evidence and boundaries only when justified"]
    end

    subgraph governed_surfaces["Typed surface writers"]
      direction TB
      radar["Radar source rows<br/>exact titles and semantic custody"]
      registry["Registry source packages<br/>plural states and outputs,<br/>no invented result fallback"]
      atlas["Atlas catalog and diagrams<br/>actual typed graph edges"]
      memory["Accepted memory and dashboard<br/>state and replay copy only when state exists"]
      delivery["Delivery and traceability<br/>release membership and proof bindings"]
    end

    package_gate["Graph-native package validator<br/>cross-surface fact retention,<br/>projection-plan equality, quality and traceability"]
    transaction["Sealed ProductCreateTransaction<br/>complete after-image and reporting fields"]

    verified_graph --> projection_plan
    projection_plan --> workstreams
    projection_plan --> components
    projection_plan --> diagrams
    workstreams --> radar
    components --> registry
    diagrams --> atlas
    projection_plan --> memory
    projection_plan --> delivery
    radar --> package_gate
    registry --> package_gate
    atlas --> package_gate
    memory --> package_gate
    delivery --> package_gate
    package_gate -- "pass" --> transaction
    package_gate -- "fail closed" --> projection_plan

    classDef authority fill:#EFF6FF,stroke:#60A5FA,color:#132033,stroke-width:1.2px;
    classDef plan fill:#F8FAFC,stroke:#94A3B8,color:#132033,stroke-width:1.2px;
    classDef surface fill:#F0FDF4,stroke:#4ADE80,color:#132033,stroke-width:1.2px;
    class verified_graph authority;
    class projection_plan,workstreams,components,diagrams,package_gate,transaction plan;
    class radar,registry,atlas,memory,delivery surface;

    style adaptive_depth fill:#FBFDFF,stroke:#94A3B8,stroke-width:1px,color:#293D52
    style governed_surfaces fill:#F8FFF9,stroke:#4ADE80,stroke-width:1px,color:#293D52
    linkStyle default stroke:#9FB2C8,stroke-width:1.25px
