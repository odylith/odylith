flowchart LR
    subgraph transaction_lane["Commit-only creation"]
      direction TB
      reviewed["Reviewed ProductCreateTransaction<br/>Hash-bound exact after-image"]
      preconditions["Receipt and precondition check<br/>Repository state must still match"]
      write["Atomic transaction write<br/>No model, parser, generation,<br/>or prose repair after CONFIRM"]
      recovery["Rollback and recovery custody<br/>Snapshot, journal, interrupt cleanup,<br/>and same-hash retry"]
      readback["Exact governed readback<br/>Published bytes match reviewed bytes"]
    end

    subgraph surface_lane["Generated product surfaces"]
      direction TB
      projections["Deterministic projections<br/>Project, Radar, Registry,<br/>Atlas, Compass, and release proof"]
      atlas_source["Atlas Mermaid source<br/>Topology truth"]
      atlas_render["Atlas render owners<br/>Browser renderer or supported<br/>static flowchart renderer"]
      surfaces["Readable HTML, payloads,<br/>SVG, and PNG artifacts"]
      browser["Browser proof<br/>Normal, empty or fallback,<br/>and degraded or error states"]
    end

    subgraph evidence_lane["Release-proof custody"]
      direction TB
      product_parser["Product semantic owners<br/>Typed graph validator and<br/>Mermaid graph parser"]
      evaluator["Evaluator adapters<br/>Reuse product owners instead of<br/>duplicating phrase or arrow rules"]
      strict_gate["Strict product gates<br/>Perfect laws and 60, 90, 120<br/>second proposal ceilings"]
      confidence["Separate confidence report<br/>Intervals explain evidence strength<br/>without weakening hard gates"]
      retain["Retained case package<br/>Raw generated files, logs,<br/>screenshots, DOM, and manifests"]
      cleanup["Temporary project cleanup<br/>Only after retained evidence is sealed"]
      release{"All quality, safety,<br/>latency, and evidence gates pass?"}
      blocker["No release claim<br/>Failure stays attributable"]
    end

    reviewed --> preconditions --> write --> readback
    write -. "failure or interruption" .-> recovery
    recovery -. "restore or safe retry" .-> write
    readback --> projections --> atlas_source --> atlas_render --> surfaces --> browser
    product_parser --> evaluator
    projections --> evaluator
    browser --> evaluator --> strict_gate --> confidence --> retain --> cleanup --> release
    release -- "no" --> blocker
    release -- "yes" --> reviewed

    classDef primary fill:#EFF6FF,stroke:#BFD7FE,color:#132033,stroke-width:1px;
    classDef execution fill:#ECFDFB,stroke:#A7E9E3,color:#132033,stroke-width:1px;
    classDef governance fill:#F5F3FF,stroke:#DDD6FE,color:#132033,stroke-width:1px;
    classDef constraint fill:#FFF8E6,stroke:#F6D98B,color:#132033,stroke-width:1px;
    classDef invalid fill:#FFF1F0,stroke:#F7B4AE,color:#132033,stroke-width:1px;
    class reviewed,preconditions,write,recovery,readback primary;
    class projections,atlas_source,atlas_render,surfaces,browser execution;
    class product_parser,evaluator,strict_gate,confidence,retain,cleanup governance;
    class release constraint;
    class blocker invalid;

    style transaction_lane fill:#FBFDFF,stroke:#BFD7FE,stroke-width:1px,color:#293D52
    style surface_lane fill:#F8FFFE,stroke:#A7E9E3,stroke-width:1px,color:#293D52
    style evidence_lane fill:#FCFBFF,stroke:#DDD6FE,stroke-width:1px,color:#293D52
    linkStyle default stroke:#9FB2C8,stroke-width:1.25px
