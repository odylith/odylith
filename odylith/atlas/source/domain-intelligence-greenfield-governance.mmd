flowchart LR
    subgraph evidence_lane["Untrusted evidence and semantic judgment"]
      direction TB
      prompt["Operator prompt or sealed EDIT evidence"]
      request["Semantic Intent request<br/>exact evidence hashes, operating envelope,<br/>pinned execution profile, one-attempt contract"]
      critic["Isolated prompt-only materiality critic<br/>classifies every canonical field<br/>without candidates or validator feedback"]
      full_author["Independent full-source graph author<br/>typed facts, relations, citations<br/>and mandatory self-challenges"]
      source_author["Independent source-only graph author<br/>distinct evidence view<br/>and mandatory self-challenges"]
      provider_schema["Provider structured-output boundaries<br/>typed graph candidates<br/>with exact source citations"]
      question["One focused clarification<br/>no authority or governed writes"]
    end

    subgraph deterministic_lane["Deterministic graph authority"]
      direction TB
      graph_verifier["Candidate admission<br/>same citation, endpoint, ownership,<br/>polarity, completeness and package laws"]
      comparison["Typed source comparison<br/>supported facts, omissions,<br/>material disagreement and utility"]
      standard_choice{"Standard convergence?"}
      selector["Selection-only rescue<br/>choose one admitted candidate unchanged<br/>or ask one material question"]
      graph_authority["Product Intent authority v8<br/>verified graph, materiality assessment,<br/>execution receipts and stable hashes"]
      projection_plan["One persisted projection plan<br/>release scope, components, workstreams,<br/>adaptive diagrams and artifact custody"]
      governed_package["Graph-native governed package<br/>Radar, Registry, Atlas, Project brief,<br/>delivery, memory and release evidence"]
      package_gate["Package and transaction validation<br/>cross-surface fact retention, quality,<br/>traceability, security and exact write set"]
      pending["Immutable pending transaction<br/>complete sealed bytes plus compiler receipt"]
      choice["Visible decision<br/>CONFIRM hash, EDIT hash, or REJECT hash"]
    end

    subgraph publication_lane["Model-free publication"]
      direction TB
      confirm["Commit-only verification<br/>receipt, hash and repository preconditions"]
      generation["Transaction-addressed generation<br/>sealed write set materialized atomically"]
      readback["Exact readback and publication proof<br/>generation manifest, fingerprints,<br/>active pointer and governed routes agree"]
      rollback["Rollback or recovery state<br/>no semantic reinterpretation"]
    end

    subgraph evidence_proof["Mechanism evidence before release"]
      direction TB
      dev_cohort["Fresh blinded development cohort<br/>distinct critic and author runs,<br/>zero retries or validation-error repair"]
      adjudication["Independent adjudication<br/>semantic fidelity, unsupported additions,<br/>utility, equivalence, latency and cost"]
      host_parity["Codex and Claude parity<br/>same graph and transaction laws"]
      lower_safety["Lower-capability safety lane<br/>clarify or fail safe; never semantic authority"]
      release_gates["Clean install, browser and distribution proof<br/>then one untouched protected holdout run"]
    end

    prompt --> request
    request --> critic
    request --> full_author
    request --> source_author
    question -- "new EDIT evidence" --> request
    full_author --> provider_schema
    source_author --> provider_schema
    provider_schema --> graph_verifier --> comparison
    critic --> comparison --> standard_choice
    standard_choice -- "materially unresolved" --> question
    standard_choice -- "one safe candidate" --> graph_authority
    standard_choice -- "reusable typed disagreement" --> selector
    selector -- "clarify" --> question
    selector -- "select existing graph" --> graph_authority
    graph_authority --> projection_plan --> governed_package
    governed_package --> package_gate
    package_gate -- "invalid" --> question
    package_gate -- "valid" --> pending --> choice
    choice -- "EDIT" --> request
    choice -- "REJECT" --> question
    choice -- "CONFIRM" --> confirm --> generation --> readback
    confirm -- "precondition failure" --> rollback
    generation -- "write or readback failure" --> rollback

    graph_authority -. "revision-bound evidence" .-> dev_cohort
    dev_cohort --> adjudication --> host_parity --> lower_safety --> release_gates
    release_gates -. "release only after every gate passes" .-> choice

    classDef evidence fill:#EFF6FF,stroke:#60A5FA,color:#132033,stroke-width:1.2px;
    classDef deterministic fill:#F8FAFC,stroke:#94A3B8,color:#132033,stroke-width:1.2px;
    classDef publication fill:#F0FDF4,stroke:#4ADE80,color:#132033,stroke-width:1.2px;
    classDef proof fill:#FFF7ED,stroke:#FB923C,color:#132033,stroke-width:1.2px;
    class prompt,request,critic,full_author,source_author,provider_schema,question evidence;
    class graph_verifier,comparison,standard_choice,selector,graph_authority,projection_plan,governed_package,package_gate,pending,choice deterministic;
    class confirm,generation,readback,rollback publication;
    class dev_cohort,adjudication,host_parity,lower_safety,release_gates proof;

    style evidence_lane fill:#FBFDFF,stroke:#60A5FA,stroke-width:1px,color:#293D52
    style deterministic_lane fill:#FBFDFF,stroke:#94A3B8,stroke-width:1px,color:#293D52
    style publication_lane fill:#F8FFF9,stroke:#4ADE80,stroke-width:1px,color:#293D52
    style evidence_proof fill:#FFFBF5,stroke:#FB923C,stroke-width:1px,color:#293D52
    linkStyle default stroke:#9FB2C8,stroke-width:1.25px
