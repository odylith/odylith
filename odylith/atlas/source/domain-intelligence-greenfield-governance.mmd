flowchart TB
    subgraph evidence_lane["Evidence and interpretation"]
      direction LR
      request["Greenfield request and EDIT evidence<br/>Untrusted input with exact source custody"]
      model_pass["One complete source and design author<br/>Pinned author inside shared model deadline"]
      typed_graph["Canonical source facts and provisional design<br/>Source prerequisites; proposed first run<br/>Distinct authority; one relation hash"]
      ambiguity{"Material meaning complete?"}
      clarify["One focused clarification<br/>No transaction or governed write"]
      request --> model_pass --> typed_graph --> ambiguity
      ambiguity -- "no" --> clarify
    end

    subgraph projection_lane["Deterministic package construction"]
      direction LR
      custody["Custody and invariant validation<br/>Stable source IDs and explicit result producer<br/>No chronology from source-list position"]
      review["Read-only complete-candidate admission<br/>Source meaning and proposed choices remain distinct<br/>One review; at most 20 seconds and remaining time"]
      denied["No admitted package<br/>No retry, repair cascade or governed write"]
      projections["Deterministic source and design projections<br/>4–5 Radar, 4–5 Registry, five Atlas views<br/>Exact release membership and dependency-ready task"]
      staged_surfaces["Temporary-root surface rendering<br/>Compass local facts and exact cache remain available<br/>No detached narration queue or worker"]
      quality["Pre-confirm complete-package gates<br/>Two-role receipt bound to source and intent<br/>Independent release qualification remains open"]
      timing["Proposal timing gate<br/>Standard at 60 seconds<br/>Rescue at 90; deep at 120"]
      custody --> review
      review -- "admitted unchanged" --> projections --> staged_surfaces --> quality --> timing
      review -- "denied, unavailable or late" --> denied
    end

    subgraph transaction_lane["Reviewed transaction boundary"]
      direction LR
      write_set["Sealed repository write set<br/>Complete after-image and preconditions<br/>Write-set hash addresses the generation"]
      generation_manifest["Pre-confirm generation manifest<br/>Exact bytes bound to the write set<br/>No enclosing transaction hash"]
      sealed["Sealed ProductCreateTransaction<br/>Write set and exact manifest bytes<br/>Distinct confirmation hash"]
      decision["One operator decision<br/>CONFIRM, EDIT, or REJECT the hash<br/>No synthetic regeneration-as-review command"]
      confirm["Commit-only CONFIRM<br/>Verify and write sealed bytes;<br/>no model, parser, generation, or repair"]
      publish["Copy sealed generation and publish pointer<br/>Journal binds confirmation hash to generation<br/>No universal atomic reader claim"]
      recovery["Recovery boundary<br/>Rollback snapshot, journal,<br/>interrupt cleanup, and safe retry"]
      write_set --> generation_manifest --> sealed --> decision --> confirm --> publish
      confirm -. "failure or interruption" .-> recovery
    end

    subgraph proof_lane["Release evidence"]
      direction LR
      owners["Product semantic owners<br/>Canonical graph and Mermaid parser"]
      evaluator["Evaluator adapters<br/>Optional source capabilities may be absent<br/>No invented samples or parallel rules"]
      acceptance["Independent semantic, transaction and UX gates<br/>Source-local candidate is unqualified<br/>60, 90, 120 second ceilings"]
      confidence["Confidence report<br/>Intervals stay separate<br/>from hard acceptance"]
      retained["Retained raw and browser proof<br/>Captured before temporary cleanup"]
      drift{"Utility improved without<br/>new failure, latency, or complexity?"}
      replace["Replace the losing mechanism<br/>Keep outcomes and invariants fixed"]
      owners --> evaluator --> acceptance --> confidence --> retained --> drift
      drift -- "no" --> replace
    end

    ambiguity -- "yes" --> custody
    timing --> write_set
    quality --> evaluator
    publish --> retained

    classDef primary fill:#EFF6FF,stroke:#BFD7FE,color:#132033,stroke-width:1px;
    classDef execution fill:#ECFDFB,stroke:#A7E9E3,color:#132033,stroke-width:1px;
    classDef governance fill:#F5F3FF,stroke:#DDD6FE,color:#132033,stroke-width:1px;
    classDef constraint fill:#FFF8E6,stroke:#F6D98B,color:#132033,stroke-width:1px;
    classDef invalid fill:#FFF1F0,stroke:#F7B4AE,color:#132033,stroke-width:1px;
    class request,model_pass,typed_graph primary;
    class custody,review,projections,staged_surfaces,quality,timing execution;
    class write_set,generation_manifest,sealed,decision,confirm,publish,recovery,owners,evaluator,acceptance,confidence,retained governance;
    class ambiguity,drift constraint;
    class clarify,denied,replace invalid;

    style evidence_lane fill:#FBFDFF,stroke:#BFD7FE,stroke-width:1px,color:#293D52
    style projection_lane fill:#F8FFFE,stroke:#A7E9E3,stroke-width:1px,color:#293D52
    style transaction_lane fill:#FCFBFF,stroke:#DDD6FE,stroke-width:1px,color:#293D52
    style proof_lane fill:#FFFCF3,stroke:#F6D98B,stroke-width:1px,color:#293D52
    linkStyle default stroke:#9FB2C8,stroke-width:1.25px
