flowchart LR
    subgraph accepted_lane["Accepted intent lane"]
      direction TB
      visible_intent["Product Intent Confirmation<br/>story, state object,<br/>first path, actors, proof boundary"]
      confirm["Single operator confirmation"]
      source_guard["Intent source boundary guard<br/>Original user intent block only,<br/>no host guidance or CLI envelope"]
      confirmed_ir["ConfirmedIntentIR<br/>section IDs, source spans,<br/>hash, provenance,<br/>grammatical object phrases"]
    end

    subgraph standard_lane["Standard path under 60s"]
      direction TB
      apply_input["Typed apply-semantic input<br/>source paths, provenance,<br/>legacy proposal bridge"]
      compiler["Deterministic semantic compiler<br/>provider-free common path"]
      semantic_ir["SemanticModelIR<br/>first-path contract,<br/>ontology, event graph,<br/>proof obligations"]
      artifact_plan["ArtifactPlanIR<br/>sanctioned projection fields"]
      projection_contract["Projection contract owner<br/>roots, aliases,<br/>envelope paths,<br/>affected projections"]
      projections["Context-starved projections<br/>Radar, Registry, Atlas,<br/>Compass, release proof"]
      next_steps["Operator next steps<br/>governed start workstream,<br/>readiness gates, validation commands"]
      project_dashboard["Project dashboard preview<br/>fragment-safe source-launch prompts<br/>from accepted project context"]
      draft_set["ArtifactDraftSet<br/>human-visible governed drafts"]
      validators["Deterministic validators<br/>schema, traceability,<br/>grammar, repetition, topology,<br/>Project prompt quality"]
      expert_lenses["Expert-lens review<br/>PM, architect, engineer,<br/>domain reviewer typed owner contract<br/>coverage over accepted systems,<br/>including deferred topology"]
      typed_findings["Source-owned typed findings<br/>target layer, target path,<br/>semantic node, no proposal-repair lane"]
      legacy_blockers["Legacy/raw issue strings<br/>diagnostic blockers only,<br/>no repair authority"]
      final_manifest{"Final manifest passes?"}
    end

    subgraph rescue_lane["Bounded rescue path up to 90s"]
      direction TB
      repairable["Repairable typed findings"]
      patchset["PatchSet request<br/>operation ID, kind, owner,<br/>target path, affected projections"]
      rescue_budget{"Rescue budget remains?"}
      tribunal_planner["Structured Tribunal patch planner<br/>host fills replacement facts only"]
      provider_adapter["Reasoning provider adapter<br/>explicit model,<br/>ignored unsafe user config"]
      strict_schema["Strict patch-plan schema<br/>fact envelope, ledger,<br/>proof delta"]
      custody_check["Patch-plan custody validator<br/>reject moved targets,<br/>invented paths, empty facts"]
      semantic_apply["SemanticModelIR patch executor<br/>operation-kind targets,<br/>exact paths, scoped posture"]
      plan_apply["ArtifactPlanIR patch executor<br/>proposal-target reroute,<br/>projection facts only"]
      scope_ledger["Patch application ledger<br/>explicit affected projections,<br/>full-prewrite posture"]
      projection_rerender["Projection rerender finding<br/>corrupted rendered scope only<br/>no host semantic patch"]
      copy_repair["Exact-path draft cleanup<br/>artifact_draft_mechanical_copy only<br/>one artifact leaf, duplicate/tail cleanup"]
      rerender["Scoped prewrite rerender<br/>named package previews,<br/>same gates, no lowered bar"]
    end

    subgraph write_lane["Fail-closed governed writes"]
      direction TB
      writes["Governed records written<br/>Radar, Registry, Atlas,<br/>Compass, release artifacts"]
      rollback["Rollback snapshot"]
      blockers["Exact final blockers<br/>operator sees actionable failure"]
      proof_log["Compass proof checkpoint"]
      release_matrix["Installed release proof<br/>expanded standard matrix,<br/>sparse and quantum confirmation cases<br/>plus rescue wiring smoke<br/>natural rescue proof still required"]
    end

    visible_intent --> confirm --> source_guard --> confirmed_ir
    confirmed_ir --> apply_input --> compiler --> semantic_ir --> artifact_plan --> projection_contract --> projections --> next_steps --> project_dashboard --> draft_set
    draft_set --> validators --> expert_lenses --> typed_findings --> final_manifest
    typed_findings -- "untyped or legacy-only evidence" --> legacy_blockers --> rollback
    final_manifest -- "pass" --> writes --> proof_log --> release_matrix
    final_manifest -- "rendered scope drift" --> projection_rerender --> rerender
    final_manifest -- "repairable typed failure" --> repairable --> patchset --> rescue_budget
    rescue_budget -- "yes" --> tribunal_planner --> provider_adapter --> strict_schema --> custody_check
    custody_check --> semantic_apply
    custody_check --> plan_apply
    custody_check --> copy_repair
    projection_contract -. "sanctioned roots + envelopes" .-> plan_apply
    projection_contract -. "dependency scope" .-> scope_ledger
    semantic_apply --> rerender
    plan_apply --> scope_ledger --> rerender
    copy_repair --> rerender
    rerender --> validators
    rescue_budget -- "no" --> rollback --> blockers
    final_manifest -- "non-repairable" --> rollback
    rollback --> blockers

    classDef intent fill:#EFF6FF,stroke:#BFD7FE,color:#17233A,stroke-width:1.2px;
    classDef standard fill:#F8FAFC,stroke:#CBD5E1,color:#17233A,stroke-width:1.2px;
    classDef rescue fill:#FFF7ED,stroke:#FDBA74,color:#17233A,stroke-width:1.2px;
    classDef write fill:#F0FDF4,stroke:#86EFAC,color:#17233A,stroke-width:1.2px;
    class visible_intent,confirm,source_guard,confirmed_ir intent;
    class apply_input,compiler,semantic_ir,artifact_plan,projection_contract,projections,next_steps,project_dashboard,draft_set,validators,expert_lenses,typed_findings,legacy_blockers,final_manifest standard;
    class repairable,patchset,rescue_budget,tribunal_planner,provider_adapter,strict_schema,custody_check,semantic_apply,plan_apply,scope_ledger,projection_rerender,copy_repair,rerender rescue;
    class writes,rollback,blockers,proof_log,release_matrix write;

    style accepted_lane fill:#FBFDFF,stroke:#BFD7FE,stroke-width:1px,color:#334155
    style standard_lane fill:#FBFDFF,stroke:#CBD5E1,stroke-width:1px,color:#334155
    style rescue_lane fill:#FFFBF5,stroke:#FDBA74,stroke-width:1px,color:#334155
    style write_lane fill:#F8FFF9,stroke:#86EFAC,stroke-width:1px,color:#334155
    linkStyle default stroke:#9FB2C8,stroke-width:1.25px
