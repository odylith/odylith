flowchart LR
    subgraph intent_lane["Intent + shallow evidence"]
      direction TB
      prompt["Greenfield prompt<br/>build, govern, plan, architect"]
      host["Claude, Codex, future hosts<br/>thin CLI routing only"]
      source["Shallow repo evidence<br/>empty, thin, metadata,<br/>docs, app-ready"]
      catalog["Domain archetype catalog<br/>product, infra, data,<br/>science/math lenses"]
    end

    subgraph reasoning_lane["Domain intelligence compiler"]
      direction TB
      compiler["Greenfield proposal compiler<br/>greenfield_proposals.py"]
      planning["Program/release/UX planner<br/>proposal_planning.py"]
      rendering["Proposal rendering<br/>operator text + apply commands"]
      proposal["Proposal payload<br/>classification, backlog, waves,<br/>release plan, components,<br/>diagrams, risks, validation"]
    end

    subgraph confirmation_lane["Confirmation-gated apply"]
      direction TB
      confirm{"Operator confirms?"}
      radar["Radar apply<br/>owned backlog authoring"]
      registry["Registry apply<br/>planned user_intent components"]
      atlas["Atlas apply<br/>draft topology diagrams"]
      release["Release targeting<br/>next/current selector"]
    end

    subgraph memory_lane["Clean runtime memory"]
      direction TB
      intervention["Intervention Engine<br/>routes without raw<br/>Observation chatter"]
      compass["Compass + memory<br/>accepted proposal context<br/>and clean timeline"]
    end

    prompt --> host
    host --> compiler
    source --> compiler
    catalog --> compiler
    compiler --> planning --> proposal
    compiler --> rendering --> proposal
    proposal --> intervention
    proposal --> confirm
    confirm -- "no" --> proposal
    confirm -- "yes" --> radar
    confirm -- "yes" --> registry
    confirm -- "yes" --> atlas
    confirm -- "yes" --> release
    radar --> compass
    registry --> compass
    atlas --> compass
    release --> compass
    intervention -. "zero-file narration filtered" .-> compass

    classDef input fill:#eafbf7,stroke:#78c9bd,color:#103f3a,stroke-width:1.2px;
    classDef intelligence fill:#eef5ff,stroke:#91b9f4,color:#183a68,stroke-width:1.2px;
    classDef decision fill:#fff6e3,stroke:#e7b96f,color:#5b3a18,stroke-width:1.3px;
    classDef apply fill:#f5efff,stroke:#bea5ea,color:#3f2b68,stroke-width:1.2px;
    classDef memory fill:#f0faed,stroke:#95cf8c,color:#174a2f,stroke-width:1.2px;
    class prompt,host,source,catalog input;
    class compiler,planning,rendering,proposal intelligence;
    class confirm decision;
    class radar,registry,atlas,release apply;
    class intervention,compass memory;

    style intent_lane fill:#f7fdfb,stroke:#b8e1db,stroke-width:1px,color:#103f3a
    style reasoning_lane fill:#f8fbff,stroke:#c9dafa,stroke-width:1px,color:#183a68
    style confirmation_lane fill:#fffaf0,stroke:#ebd0a0,stroke-width:1px,color:#5b3a18
    style memory_lane fill:#f9fdf6,stroke:#cbe4c3,stroke-width:1px,color:#174a2f
    linkStyle default stroke:#7893ad,stroke-width:1.45px
