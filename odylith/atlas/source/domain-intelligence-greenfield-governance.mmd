flowchart LR
    subgraph confirmation_lane["Accepted intent"]
      direction TB
      visible_intent["Product Intent Confirmation<br/>visible story, first path,<br/>actors, systems, proof boundary"]
      confirm["Operator confirm<br/>single post-confirm create"]
      confirmed_ir["ConfirmedIntentIR<br/>section IDs, source spans,<br/>hash, provenance"]
    end

    subgraph reasoning_lane["Host reasoning"]
      direction TB
      semantic_compile["Semantic compiler call<br/>host resolves meaning"]
      semantic_ir["SemanticModelIR<br/>actors, actions, state,<br/>events, proof, risks"]
      decision_ledger["Decision ledger<br/>ambiguities and rejected<br/>interpretations"]
      patchset["PatchSet<br/>semantic or plan patch<br/>with confidence"]
      patch_apply["PatchSet applier<br/>operation-level repair<br/>before rerender"]
    end

    subgraph custody_lane["Deterministic Odylith custody"]
      direction TB
      plan_ir["ArtifactPlanIR<br/>surface-specific projections"]
      draft_set["ArtifactDraftSet<br/>Radar, Registry, Atlas,<br/>Compass, release proof"]
      validators["Schema, traceability,<br/>copy, repetition, grammar,<br/>and topology gates"]
      review_report["ReviewReport<br/>typed PM, architect,<br/>engineer, domain findings"]
      transaction{"Final manifest<br/>passes?"}
    end

    subgraph projection_lane["Context-starved renderers"]
      direction TB
      radar_sentence["Radar sentence projection<br/>validation and proof predicates<br/>normalized before render"]
      radar["Radar projection<br/>product slices only"]
      registry["Registry projection<br/>component contracts only"]
      atlas["Atlas projection<br/>topology and event flow"]
      compass["Compass projection<br/>decision and proof record"]
      release["Release proof<br/>scope and validation"]
    end

    subgraph write_lane["Fail-closed governed writes"]
      direction TB
      writes["Source-truth writes<br/>only after final pass"]
      rollback["Rollback snapshot<br/>for failed transactions"]
      blockers["Exact blockers<br/>when repair is exhausted"]
    end

    visible_intent --> confirm --> confirmed_ir
    confirmed_ir --> semantic_compile --> semantic_ir
    semantic_compile --> decision_ledger
    semantic_ir --> plan_ir --> draft_set
    plan_ir --> radar_sentence --> radar
    plan_ir --> registry
    plan_ir --> atlas
    plan_ir --> compass
    plan_ir --> release
    radar --> draft_set
    registry --> draft_set
    atlas --> draft_set
    compass --> draft_set
    release --> draft_set
    draft_set --> validators --> review_report --> transaction
    transaction -- "pass under 60s standard path" --> writes
    transaction -- "repairable final-gate failure" --> patchset
    patchset --> patch_apply
    patch_apply -- "under 90s rescue path" --> semantic_ir
    patch_apply --> plan_ir
    transaction -- "non-repairable or budget exhausted" --> rollback --> blockers
    writes --> compass

    classDef intent fill:#EFF6FF,stroke:#BFD7FE,color:#17233A,stroke-width:1.2px;
    classDef reasoning fill:#F5F3FF,stroke:#DDD6FE,color:#17233A,stroke-width:1.2px;
    classDef custody fill:#FFF8E6,stroke:#F6D98B,color:#17233A,stroke-width:1.3px;
    classDef projection fill:#ECFDFB,stroke:#A7E9E3,color:#17233A,stroke-width:1.2px;
    classDef write fill:#FDF2F8,stroke:#F9A8D4,color:#17233A,stroke-width:1.2px;
    class visible_intent,confirm,confirmed_ir intent;
    class semantic_compile,semantic_ir,decision_ledger,patchset,patch_apply reasoning;
    class plan_ir,draft_set,validators,review_report,transaction custody;
    class radar_sentence,radar,registry,atlas,compass,release projection;
    class writes,rollback,blockers write;

    style confirmation_lane fill:#FBFDFF,stroke:#BFD7FE,stroke-width:1px,color:#334155
    style reasoning_lane fill:#FBFDFF,stroke:#DDD6FE,stroke-width:1px,color:#334155
    style custody_lane fill:#FBFDFF,stroke:#F6D98B,stroke-width:1px,color:#334155
    style projection_lane fill:#FBFDFF,stroke:#A7E9E3,stroke-width:1px,color:#334155
    style write_lane fill:#FBFDFF,stroke:#F9A8D4,stroke-width:1px,color:#334155
    linkStyle default stroke:#B9C7D8,stroke-width:1.25px
