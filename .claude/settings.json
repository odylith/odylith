{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "async": true,
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.agents/bin/odylith-host-launcher.py claude post-edit-checkpoint --repo-root \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 180,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.agents/bin/odylith-host-launcher.py claude post-bash-checkpoint --repo-root \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 180,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.agents/bin/odylith-host-launcher.py claude pre-compact-snapshot --repo-root \"$CLAUDE_PROJECT_DIR\" --quiet",
            "timeout": 20,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.agents/bin/odylith-host-launcher.py claude bash-guard --repo-root \"$CLAUDE_PROJECT_DIR\"",
            "if": "Bash(rm *)",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.agents/bin/odylith-host-launcher.py claude bash-guard --repo-root \"$CLAUDE_PROJECT_DIR\"",
            "if": "Bash(git reset --hard*)",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.agents/bin/odylith-host-launcher.py claude bash-guard --repo-root \"$CLAUDE_PROJECT_DIR\"",
            "if": "Bash(git checkout --*)",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.agents/bin/odylith-host-launcher.py claude bash-guard --repo-root \"$CLAUDE_PROJECT_DIR\"",
            "if": "Bash(git push --force*)",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.agents/bin/odylith-host-launcher.py claude bash-guard --repo-root \"$CLAUDE_PROJECT_DIR\"",
            "if": "Bash(git clean -fdx*)",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.agents/bin/odylith-host-launcher.py claude bash-guard --repo-root \"$CLAUDE_PROJECT_DIR\"",
            "if": "Bash(*shutil.rmtree*)",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.agents/bin/odylith-host-launcher.py claude bash-guard --repo-root \"$CLAUDE_PROJECT_DIR\"",
            "if": "Bash(*odylith backlog create*)",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.agents/bin/odylith-host-launcher.py claude session-start --repo-root \"$CLAUDE_PROJECT_DIR\" --quiet",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.agents/bin/odylith-host-launcher.py claude stop-summary --repo-root \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 20,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.agents/bin/odylith-host-launcher.py claude subagent-start --repo-root \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 20,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "async": true,
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.agents/bin/odylith-host-launcher.py claude subagent-stop --repo-root \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.agents/bin/odylith-host-launcher.py claude prompt-bundle --repo-root \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(./.odylith/bin/odylith start:*)",
      "Bash(./.odylith/bin/odylith context:*)",
      "Bash(./.odylith/bin/odylith query:*)",
      "Bash(./.odylith/bin/odylith show:*)",
      "Bash(./.odylith/bin/odylith capabilities:*)",
      "Bash(./.odylith/bin/odylith --help:*)",
      "Bash(./.odylith/bin/odylith version:*)",
      "Bash(./.odylith/bin/odylith doctor:*)",
      "Bash(./.odylith/bin/odylith sync:*)",
      "Bash(./.odylith/bin/odylith atlas:*)",
      "Bash(./.odylith/bin/odylith backlog:*)",
      "Bash(./.odylith/bin/odylith validate:*)",
      "Bash(./.odylith/bin/odylith governance:*)",
      "Bash(./.odylith/bin/odylith compass refresh:*)",
      "Bash(./.odylith/bin/odylith compass log:*)",
      "Bash(./.odylith/bin/odylith context-engine:*)",
      "Bash(./.odylith/bin/odylith claude:*)",
      "Bash(./.odylith/bin/odylith codex:*)"
    ]
  },
  "statusLine": {
    "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/statusline.sh",
    "padding": 0,
    "type": "command"
  }
}
