#!/usr/bin/env bash
set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_odylith.sh"

case_files_raw="${GREENFIELD_MATRIX_SOURCE_CASE_FILES:-${GREENFIELD_MATRIX_CASE_FILE:-}}"
output_dir="${GREENFIELD_MATRIX_SHARD_DIR:-${TMPDIR:-/tmp}/odylith-greenfield-matrix-shards}"
extra_args=(--output-dir "$output_dir")

if [[ -z "$case_files_raw" ]]; then
  die "set GREENFIELD_MATRIX_SOURCE_CASE_FILES to one or more comma-separated JSON case files"
fi

IFS=',' read -r -a case_files <<< "$case_files_raw"
for file in "${case_files[@]}"; do
  if [[ -n "$file" ]]; then
    extra_args+=(--case-file "$file")
  fi
done

if [[ -n "${GREENFIELD_MATRIX_FAILED_RESULT_JSONS:-}" ]]; then
  IFS=',' read -r -a failed_jsons <<< "$GREENFIELD_MATRIX_FAILED_RESULT_JSONS"
  for file in "${failed_jsons[@]}"; do
    if [[ -n "$file" ]]; then
      extra_args+=(--failed-result-json "$file")
    fi
  done
fi
if [[ -n "${GREENFIELD_MATRIX_SHARD_SIZE:-}" ]]; then
  extra_args+=(--shard-size "$GREENFIELD_MATRIX_SHARD_SIZE")
fi
if [[ -n "${GREENFIELD_MATRIX_REGRESSION_SIZE:-}" ]]; then
  extra_args+=(--regression-size "$GREENFIELD_MATRIX_REGRESSION_SIZE")
fi
if [[ -n "${GREENFIELD_MATRIX_VOLUME_SIZE:-}" ]]; then
  extra_args+=(--volume-size "$GREENFIELD_MATRIX_VOLUME_SIZE")
fi
if [[ -n "${GREENFIELD_MATRIX_DEEP_VOLUME_SIZE:-}" ]]; then
  extra_args+=(--deep-volume-size "$GREENFIELD_MATRIX_DEEP_VOLUME_SIZE")
fi
if [[ -n "${GREENFIELD_MATRIX_RELEASE_SIZE:-}" ]]; then
  extra_args+=(--release-size "$GREENFIELD_MATRIX_RELEASE_SIZE")
fi
if [[ "${GREENFIELD_MATRIX_FAILED_SUBSET_ONLY:-0}" == "1" ]]; then
  extra_args+=(--failed-subset-only)
fi
if [[ "${GREENFIELD_MATRIX_REQUIRE_HIGH_VARIANCE_STRESSORS:-0}" == "1" ]]; then
  extra_args+=(--require-high-variance-stressors)
fi
if [[ -n "${GREENFIELD_MATRIX_REQUIRED_STRESSORS:-}" ]]; then
  IFS=',' read -r -a required_stressors <<< "$GREENFIELD_MATRIX_REQUIRED_STRESSORS"
  for stressor in "${required_stressors[@]}"; do
    if [[ -n "$stressor" ]]; then
      extra_args+=(--required-stressor "$stressor")
    fi
  done
fi
if [[ -n "${GREENFIELD_MATRIX_SHARDS_OUTPUT_JSON:-}" ]]; then
  extra_args+=(--output-json "$GREENFIELD_MATRIX_SHARDS_OUTPUT_JSON")
fi

"$odylith_python" scripts/release/greenfield_matrix_shards.py "${extra_args[@]}"
