#!/usr/bin/env bash
set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_odylith.sh"

requested_version="${1:-${VERSION:-$(current_source_version)}}"
dist_arg="${2:-${DIST:-}}"
temp_parent="${TEMP_PARENT:-${TMPDIR:-/tmp}}"
require_version "$requested_version"

if [[ -z "$dist_arg" ]]; then
  dist_dir="${TMPDIR:-/tmp}/odylith-local-release-${requested_version}"
elif [[ "$dist_arg" == /* ]]; then
  dist_dir="$dist_arg"
else
  dist_dir="$odylith_repo_root/$dist_arg"
fi

if [[ ! -f "$dist_dir/install.sh" ]]; then
  die "local release dist is missing install.sh: $dist_dir"
fi

require_current_component_forensics
"$odylith_python" scripts/release/platform_domain_leakage_check.py --repo-root "$odylith_repo_root" --dist-dir "$dist_dir"

proof_json="${GREENFIELD_MATRIX_OUTPUT_JSON:-$dist_dir/greenfield-preconfirm-matrix.v1.json}"

extra_args=()
rescue_smoke_enabled=1
natural_rescue_enabled=1
browser_proof_enabled=1
if [[ "${RESCUE_SMOKE:-1}" == "0" ]]; then
  rescue_smoke_enabled=0
fi
if [[ "${NATURAL_RESCUE_PROOF:-1}" == "0" ]]; then
  natural_rescue_enabled=0
fi
if [[ "${BROWSER_PROOF:-1}" == "0" ]]; then
  browser_proof_enabled=0
fi
release_case_file="${GREENFIELD_MATRIX_CASE_FILE:-}"
release_audit_file="${GREENFIELD_MATRIX_RELEASE_AUDIT_FILE:-}"
release_intent="${GREENFIELD_MATRIX_RELEASE_INTENT:-0}"
if [[ "$release_intent" != "0" && "$release_intent" != "1" ]]; then
  die "GREENFIELD_MATRIX_RELEASE_INTENT must be 0 or 1"
fi
if [[ "$release_intent" == "1" ]]; then
  [[ -n "$release_case_file" ]] || die "GREENFIELD_MATRIX_RELEASE_INTENT=1 requires GREENFIELD_MATRIX_CASE_FILE"
  [[ -f "$release_case_file" ]] || die "GREENFIELD_MATRIX_RELEASE_INTENT=1 case file is missing: $release_case_file"
  [[ -n "$release_audit_file" ]] || die "GREENFIELD_MATRIX_RELEASE_INTENT=1 requires GREENFIELD_MATRIX_RELEASE_AUDIT_FILE"
  [[ -f "$release_audit_file" ]] || die "GREENFIELD_MATRIX_RELEASE_INTENT=1 audit file is missing: $release_audit_file"
  [[ "$rescue_smoke_enabled" == "1" ]] || die "GREENFIELD_MATRIX_RELEASE_INTENT=1 requires RESCUE_SMOKE=1"
  [[ "$natural_rescue_enabled" == "1" ]] || die "GREENFIELD_MATRIX_RELEASE_INTENT=1 requires NATURAL_RESCUE_PROOF=1"
  [[ "$browser_proof_enabled" == "1" ]] || die "GREENFIELD_MATRIX_RELEASE_INTENT=1 requires BROWSER_PROOF=1"
elif [[ -n "$release_audit_file" && -z "$release_case_file" ]]; then
  die "GREENFIELD_MATRIX_RELEASE_AUDIT_FILE requires GREENFIELD_MATRIX_CASE_FILE"
fi
if [[ "$release_intent" == "1" || ( "$rescue_smoke_enabled" == "1" && "$natural_rescue_enabled" == "1" && "$browser_proof_enabled" == "1" && -n "$release_case_file" && -n "$release_audit_file" ) ]]; then
  extra_args+=(--proof-tier release)
else
  extra_args+=(--proof-tier discovery)
fi
if [[ "$rescue_smoke_enabled" == "1" ]]; then
  extra_args+=(--include-rescue-smoke)
else
  extra_args+=(--skip-rescue-smoke)
fi
if [[ "$natural_rescue_enabled" == "1" ]]; then
  extra_args+=(--include-natural-rescue-proof)
else
  extra_args+=(--skip-natural-rescue-proof)
fi
if [[ "$browser_proof_enabled" == "1" ]]; then
  extra_args+=(--include-browser-proof)
  ensure_playwright_chromium
else
  extra_args+=(--allow-skipped-browser-proof)
fi
if [[ -n "$release_case_file" ]]; then
  extra_args+=(--case-file "$release_case_file")
fi
if [[ -n "$release_audit_file" ]]; then
  extra_args+=(--release-audit-file "$release_audit_file")
fi
if [[ -n "${GREENFIELD_MATRIX_INSTALL_MODE:-}" ]]; then
  extra_args+=(--install-mode "$GREENFIELD_MATRIX_INSTALL_MODE")
fi
if [[ -n "${GREENFIELD_MATRIX_TELEMETRY_JSONL:-}" ]]; then
  extra_args+=(--telemetry-jsonl "$GREENFIELD_MATRIX_TELEMETRY_JSONL")
fi
if [[ -n "${GREENFIELD_MATRIX_CAMPAIGN_PHASE:-}" ]]; then
  extra_args+=(--campaign-phase "$GREENFIELD_MATRIX_CAMPAIGN_PHASE")
fi
if [[ -n "${GREENFIELD_MATRIX_STOP_AFTER_FAILURES:-}" ]]; then
  extra_args+=(--stop-after-failures "$GREENFIELD_MATRIX_STOP_AFTER_FAILURES")
fi
if [[ -n "${GREENFIELD_MATRIX_STOP_AFTER_CLUSTER_FAILURES:-}" ]]; then
  extra_args+=(--stop-after-cluster-failures "$GREENFIELD_MATRIX_STOP_AFTER_CLUSTER_FAILURES")
fi
if [[ "${GREENFIELD_MATRIX_REQUIRE_HIGH_VARIANCE_STRESSORS:-0}" == "1" ]]; then
  extra_args+=(--require-high-variance-stressors)
fi
if [[ -n "${GREENFIELD_MATRIX_REQUIRED_STRESSORS:-}" ]]; then
  IFS=',' read -r -a required_stressors <<< "$GREENFIELD_MATRIX_REQUIRED_STRESSORS"
  for stressor in "${required_stressors[@]}"; do
    if [[ -n "$stressor" ]]; then
      extra_args+=(--required-stressor "$stressor")
    fi
  done
fi

"$odylith_python" scripts/release/greenfield_preconfirm_matrix.py \
  --dist-dir "$dist_dir" \
  --version "$requested_version" \
  --temp-parent "$temp_parent" \
  --output-json "$proof_json" \
  "${extra_args[@]}"
