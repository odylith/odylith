#!/usr/bin/env bash
set -euo pipefail

cat <<'EOF'
Odylith maintainer interface

make validate
  Run the baseline maintainer validation suite.

make dev-validate
  Run the detached source-local maintainer validation lane for current unreleased workspace changes.

make license-audit
  Audit the runtime dependency closure and refresh THIRD_PARTY_ATTRIBUTION.md.

make lane-show
  Show maintainer lane posture, release session state, version drift, benchmark compare, and the exact next command.

make benchmark-analysis [OUT=/tmp/odylith-benchmark-...]
  Run diagnostic then proof, archive logs plus JSON artifacts plus SVG graphs into a local analysis bundle, emit a markdown summary for deeper benchmark review, and show heartbeat progress plus ETA while long stages run.

make release-version-preview
  Print the next auto patch version without mutating tags or session state.

make release-version-show
  Show session state, highest semver tag, next auto tag, and the effective release version.

make release-session-show
  Show the raw sticky release-session fields under .odylith/locks/.

make local-release-assets [VERSION=X.Y.Z] [DIST=/tmp/odylith-local-release-X.Y.Z]
  Build local installable release assets for maintainer smoke testing without dispatching a release.

make greenfield-preconfirm-matrix [VERSION=X.Y.Z] [DIST=/tmp/odylith-local-release-X.Y.Z] [TEMP_PARENT=/tmp]
  Run the 10+ case installed Greenfield transaction matrix. It proves pre-confirm compilation and commit-only confirmation, with per-case generated browser surface state proof, installed CLI auto-rescue wiring smoke, host-planned structured rescue proof, and an installed SIGKILL/same-hash-retry/fsync-rollback proof. It will write greenfield-preconfirm-matrix.v1.json and fail closed on missing governed records, browser failures, recovery-proof failures, rescue-proof failures, or review-lens failures. Set GREENFIELD_MATRIX_CASE_FILE=/path/cases.json for an explicit fresh-variance case file. Set GREENFIELD_MATRIX_TELEMETRY_JSONL=/path/progress.jsonl, GREENFIELD_MATRIX_CAMPAIGN_PHASE=name, GREENFIELD_MATRIX_STOP_AFTER_FAILURES=N, GREENFIELD_MATRIX_STOP_AFTER_CLUSTER_FAILURES=N, GREENFIELD_MATRIX_REQUIRED_STRESSORS=a,b, or GREENFIELD_MATRIX_REQUIRE_HIGH_VARIANCE_STRESSORS=1 for discovery telemetry and stressor coverage. RESCUE_SMOKE=0, NATURAL_RESCUE_PROOF=0, BROWSER_PROOF=0, or COMMIT_RECOVERY_PROOF=0 skips that lane only for local debugging, automatically downgrades the run to discovery proof, and is not release proof.

make greenfield-matrix-shards
  Build tier-ready Greenfield case shards from external JSON case files and prior result JSON. Set GREENFIELD_MATRIX_SOURCE_CASE_FILES, optionally GREENFIELD_MATRIX_FAILED_RESULT_JSONS, GREENFIELD_MATRIX_SHARD_DIR, GREENFIELD_MATRIX_SHARD_SIZE, GREENFIELD_MATRIX_REGRESSION_SIZE, GREENFIELD_MATRIX_VOLUME_SIZE, GREENFIELD_MATRIX_DEEP_VOLUME_SIZE, GREENFIELD_MATRIX_RELEASE_SIZE, GREENFIELD_MATRIX_REQUIRED_STRESSORS, or GREENFIELD_MATRIX_REQUIRE_HIGH_VARIANCE_STRESSORS=1. The output summary includes campaign env values for failed-subset replay, 60-case regression, 120-case discovery, 240-case discovery, and a release candidate that requires independent source-provenance audit evidence before it can make a release claim.

make greenfield-matrix-campaign [VERSION=X.Y.Z] [DIST=/tmp/odylith-local-release-X.Y.Z] [TEMP_PARENT=/tmp]
  Run a tiered Greenfield campaign against explicit shard files: exact failed subset, 60-case regression, 120-case discovery, 240-case discovery, then source-provenanced release proof. Set GREENFIELD_MATRIX_FAILED_CASE_FILES, GREENFIELD_MATRIX_REGRESSION_CASE_FILES, GREENFIELD_MATRIX_VOLUME_CASE_FILES, GREENFIELD_MATRIX_DEEP_VOLUME_CASE_FILES, and GREENFIELD_MATRIX_RELEASE_CASE_FILES as comma-separated JSON case files. A release case file also requires GREENFIELD_MATRIX_RELEASE_AUDIT_FILE; the wrapper then requires release readiness and exits nonzero unless that audited corpus proves it. Discovery tiers use seeded installs, per-case JSONL telemetry, controlled concurrency, merged campaign progress, compact live progress lines, incremental result payload flushing, failure clustering, and early stop thresholds. Failed campaigns emit a failure-response packet for Casebook capture, exact failed-subset replay, and resume sequencing. Set GREENFIELD_MATRIX_CAMPAIGN_PROGRESS_JSONL or GREENFIELD_MATRIX_CAMPAIGN_PROGRESS_JSON for live merged progress outputs, or GREENFIELD_MATRIX_QUIET_PROGRESS=1 for machine-only logs. Optional per-tier worker envs: GREENFIELD_MATRIX_FAILED_SUBSET_MAX_WORKERS, GREENFIELD_MATRIX_REGRESSION_MAX_WORKERS, GREENFIELD_MATRIX_VOLUME_MAX_WORKERS, and GREENFIELD_MATRIX_DEEP_VOLUME_MAX_WORKERS.

make release-candidate [VERSION=X.Y.Z]
  Run the shared non-publishing release-proof lane on the current clean checkout, including installed Greenfield transaction-matrix proof, and compare benchmarks against the last shipped release baseline.

make release-preflight [VERSION=X.Y.Z]
  Initialize or reuse the sticky release session, reserve the release tag, and run preflight checks.

make release-dispatch
  Reuse the active release session and dispatch the canonical GitHub release workflow.

make dogfood-activate
  Return the product repo from detached source-local to the pinned installed runtime.

make consumer-rehearsal [VERSION=X.Y.Z] [PREVIOUS_VERSION=Y.Y.Y]
  Exercise a disposable consumer repo against hosted release assets. VERSION defaults to the active release session.

make ga-gate [VERSION=X.Y.Z] [PREVIOUS_VERSION=Y.Y.Y]
  Run the post-publish dogfood and consumer rehearsal gate for the session version or explicit version.
  Do not run consumer-rehearsal separately for the same published artifact.

make release-session-clear
  Clear the sticky release session after a completed lane or intentional abort.
EOF
