#!/usr/bin/env bash
set -euo pipefail
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_odylith.sh"

requested_version="${1:-}"
resolved_version="${requested_version:-${VERSION:-$(current_source_version)}}"
require_version "$resolved_version"

# CI may repair the repo-local launcher before this target runs. That repair is
# allowed to rewrite generated local guidance and runtime snapshots, but release
# candidate proof must evaluate the checked-out source tree, not repair residue.
git restore -- AGENTS.md CLAUDE.md .agents .claude .codex odylith/compass/runtime >/dev/null 2>&1 || true
git clean -fd -- .agents .claude .codex odylith/compass/runtime >/dev/null 2>&1 || true
require_clean_worktree

candidate_root="$(mktemp -d "${TMPDIR:-/tmp}/odylith-release-candidate.XXXXXX")"
dist_dir="$candidate_root/dist"
mkdir -p "$dist_dir"
trap 'rm -rf "$candidate_root"' EXIT

run_release_proof_steps "$resolved_version" "$dist_dir" discovery
benchmark_override_mode="$(release_benchmark_override_mode "$resolved_version")"
if [[ "$benchmark_override_mode" == "skip_proof_and_compare" ]]; then
  echo "benchmark compare skipped for v${resolved_version}: tracked maintainer override marks benchmark proof advisory for this exact release"
else
  odylith_cli benchmark compare --repo-root . --baseline last-shipped
fi

echo "release candidate proof ready for v${resolved_version}"
